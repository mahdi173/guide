<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd"
>
    <key>journal_details</key>

    <properties>
        <property name="title" type="text_line" mandatory="true" colspan="12">
            <meta>
                <title>sulu_admin.title</title>
            </meta>
        </property>

        <property name="ejr" type="text_line" colspan="12">
            <meta>
                <title>app.ejr</title>
            </meta>
        </property>

        <property name="printISSN" type="text_line" colspan="12">
            <meta>
                <title>app.printissn</title>
            </meta>
        </property>

        <property name="eissn" type="text_line" colspan="12">
            <meta>
                <title>app.eissn</title>
            </meta>
        </property>

        <property name="rank" type="text_line" colspan="12">
            <meta>
                <title>app.rank</title>
            </meta>
        </property>

        <property name="contributor" type="single_contact_selection">
            <meta>
                <title lang="en">Contributor</title>
            </meta>
            <params>
                <param name="type" value="auto_complete" />
            </params>
        </property>

        <property name="publisherOrg" type="single_account_selection" colspan="12">
            <meta>
                <title>app.publisher_org</title>
            </meta>
        </property>
    </properties>
</form>
