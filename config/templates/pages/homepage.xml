<?xml version="1.0" ?>

<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>homepage</key>

    <view>pages/homepage</view>
    <controller>App\Controller\Website\DefaultController::indexAction</controller>
    <cacheLifetime>86400</cacheLifetime>

    <meta>
        <title lang="en">Homepage</title>
        <title lang="de">Startseite</title>
        <title lang="fr">Accueil</title>
    </meta>

    <properties>

        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title lang="en">Title page</title>
                <title lang="de">Titel page</title>
                <title lang="fr">Titre page</title>
            </meta>
            <params>
                <param name="headline" value="true"/>
            </params>

            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="resource_locator" mandatory="true">
            <meta>
                <title lang="en">Resourcelocator</title>
                <title lang="de">Adresse</title>
                <title lang="fr">Url</title>
            </meta>

            <tag name="sulu.rlp"/>
        </property>


        <property name="featured_articles" type="smart_content">
            <meta>
                <title lang="en">Featured articles</title>
                <title lang="fr">Articles à la une</title>
            </meta>

            <params>
                <param name="properties" type="collection">
                    <param name="article" value="article"/>
                    <param name="excerptTitle" value="excerpt.title"/>
                    <param name="cover_image" value="cover_image"/>
                    <param name="excerptTags" value="excerpt.tags"/>
                    <param name="excerptDescription" value="excerpt.description"/>
                </param>

                <param name="provider" value="pages"/>
                <param name="max_per_page" value="6"/>
                <param name="page_parameter" value="p"/>
            </params>
        </property>
    </properties>
</template>
