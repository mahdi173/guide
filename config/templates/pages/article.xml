<?xml version="1.0" ?>

<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>article</key>

    <view>pages/article</view>
    <controller>Sulu\Bundle\WebsiteBundle\Controller\DefaultController::indexAction</controller>
    <cacheLifetime>86400</cacheLifetime>

    <meta>
        <title lang="en">Article</title>
        <title lang="fr">Article</title>
    </meta>

    <properties>

        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title lang="en">Title</title>
                <title lang="fr">Titre</title>
            </meta>
            <params>
                <param name="headline" value="true"/>
            </params>

            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="resource_locator" mandatory="true">
            <meta>
                <title lang="en">Resourcelocator</title>
                <title lang="fr">Url</title>
            </meta>

            <tag name="sulu.rlp"/>
        </property>

        <property name="video_url" type="url">
            <meta>
                <title lang="en">URL video (youtube)</title>
                <title lang="fr">URL video (youtube)</title>
            </meta>
        </property>

        <property name="cover_image" type="single_media_selection">
            <meta>
                <title lang="en">Cover image</title>
                <title lang="fr">Cover image</title>
            </meta>

            <params>
                <param name="types" value="image"/>
                <param name="displayOptions" type="collection">
                    <param name="leftTop" value="true"/>
                    <param name="top" value="true"/>
                    <param name="rightTop" value="true"/>
                    <param name="left" value="true"/>
                    <param name="middle" value="false"/>
                    <param name="right" value="true"/>
                    <param name="leftBottom" value="true"/>
                    <param name="bottom" value="true"/>
                    <param name="rightBottom" value="true"/>
                </param>
                <param name="defaultDisplayOption" value="left"/>
            </params>
        </property>

        <property name="article" type="text_editor">
            <meta>
                <title lang="en">Article</title>
                <title lang="fr">Contenu</title>
            </meta>
        </property>

        <block name="blocks" default-type="content_block" minOccurs="0">
            <meta>
                <title lang="fr">Blocks de contenus</title>
                <title lang="en">Content</title>
            </meta>

            <types>
                <type name="content_block">
                    <meta>
                        <title lang="fr">Contenu</title>
                        <title lang="en">Content</title>
                    </meta>

                    <properties>
                        <property name="content" type="text_editor" colspan="9">
                            <meta>
                                <title lang="fr">Contenu</title>
                                <title lang="en">Content</title>
                            </meta>

                            <tag name="sulu.block_preview" priority="1024"/>
                        </property>
                    </properties>
                </type>
            </types>
        </block>

        <property name="categories" type="category_selection">
            <meta>
                <title lang="en">Category Selection</title>
            </meta>
        </property>
        <property name="tags" type="tag_selection">
            <meta>
                <title lang="en">Tags</title>
            </meta>
        </property>
    </properties>
</template>
