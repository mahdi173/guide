<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>journals</key>

    <properties>
        <property name="id" visibility="no" translation="sulu_admin.id">
            <field-name>id</field-name>
            <entity-name>App\Entity\Journal</entity-name>
        </property>

        <property name="title" visibility="always" searchability="yes" translation="sulu_admin.name">
            <field-name>title</field-name>
            <entity-name>App\Entity\Journal</entity-name>
        </property>

        <property name="publisher" visibility="yes" translation="app.publisher" >
            <field-name>publisher</field-name>
            <entity-name>App\Entity\Journal</entity-name>
        </property>
        <property name="ejr" visibility="yes" translation="app.ejr" >
            <field-name>ejr</field-name>
            <entity-name>App\Entity\Journal</entity-name>
        </property>
        <property name="openaccess" visibility="yes" translation="app.openaccess" >
            <field-name>openaccess</field-name>
            <entity-name>App\Entity\Journal</entity-name>
        </property>
        <property name="printissn" visibility="yes" translation="app.printissn" >
            <field-name>printissn</field-name>
            <entity-name>App\Entity\Journal</entity-name>
        </property>
        <property name="eissn" visibility="yes" translation="app.eissn" >
            <field-name>eissn</field-name>
            <entity-name>App\Entity\Journal</entity-name>
        </property>
        <property name="rank" visibility="yes" translation="app.rank" >
            <field-name>rank</field-name>
            <entity-name>App\Entity\Journal</entity-name>
        </property>
    </properties>
</list>
