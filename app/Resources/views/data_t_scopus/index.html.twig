{% extends 'base.html.twig' %}

{% block body %}
    <h1>Data_t_scopuses list</h1>

    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Scopussourceid</th>
                <th>Title</th>
                <th>Citescore</th>
                <th>Citationcount</th>
                <th>Sjr</th>
                <th>Rank</th>
                <th>Publisher</th>
                <th>Openaccess</th>
                <th>Scopussubsubjectarea</th>
                <th>Quartile</th>
                <th>Printissn</th>
                <th>Eissn</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for data_t_scopus in data_t_scopuses %}
            <tr>
                <td><a href="{{ path('data_t_scopus_show', { 'id': data_t_scopus.id }) }}">{{ data_t_scopus.id }}</a></td>
                <td>{{ data_t_scopus.scopusSourceID }}</td>
                <td>{{ data_t_scopus.title }}</td>
                <td>{{ data_t_scopus.citeScore }}</td>
                <td>{{ data_t_scopus.citationCount }}</td>
                <td>{{ data_t_scopus.sJR }}</td>
                <td>{{ data_t_scopus.rANK }}</td>
                <td>{{ data_t_scopus.publisher }}</td>
                <td>{{ data_t_scopus.openAccess }}</td>
                <td>{{ data_t_scopus.scopusSubSubjectArea }}</td>
                <td>{{ data_t_scopus.quartile }}</td>
                <td>{{ data_t_scopus.printISSN }}</td>
                <td>{{ data_t_scopus.eISSN }}</td>
                <td>
                    <ul>
                        <li>
                            <a href="{{ path('data_t_scopus_show', { 'id': data_t_scopus.id }) }}">show</a>
                        </li>
                        <li>
                            <a href="{{ path('data_t_scopus_edit', { 'id': data_t_scopus.id }) }}">edit</a>
                        </li>
                    </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <ul>
        <li>
            <a href="{{ path('data_t_scopus_new') }}">Create a new data_t_scopus</a>
        </li>
    </ul>
{% endblock %}
