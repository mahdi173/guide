{% extends 'base.html.twig' %}

{% block body %}
    <h1>Data_reuters list</h1>

    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Rank</th>
                <th>Title</th>
                <th>Totalcites</th>
                <th>Journalimpactfactor</th>
                <th>Eigenfactorscore</th>
                <th>Issn</th>
                <th>Eissn</th>
                <th>Categoryname</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for data_reuter in data_reuters %}
            <tr>
                <td><a href="{{ path('data_reuters_show', { 'id': data_reuter.id }) }}">{{ data_reuter.id }}</a></td>
                <td>{{ data_reuter.rank }}</td>
                <td>{{ data_reuter.title }}</td>
                <td>{{ data_reuter.totalCites }}</td>
                <td>{{ data_reuter.journalImpactFactor }}</td>
                <td>{{ data_reuter.eigenfactorScore }}</td>
                <td>{{ data_reuter.iSSN }}</td>
                <td>{{ data_reuter.eISSN }}</td>
                <td>{{ data_reuter.categoryname }}</td>
                <td>
                    <ul>
                        <li>
                            <a href="{{ path('data_reuters_show', { 'id': data_reuter.id }) }}">show</a>
                        </li>
                        <li>
                            <a href="{{ path('data_reuters_edit', { 'id': data_reuter.id }) }}">edit</a>
                        </li>
                    </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <ul>
        <li>
            <a href="{{ path('data_reuters_new') }}">Create a new data_reuter</a>
        </li>
    </ul>
{% endblock %}
