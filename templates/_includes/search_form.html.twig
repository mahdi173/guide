<form method="get" action="{{ url('data_search_by_several_values') }}">
{#    <h2 class="text-primary"><b>Find the best journal for your research</b></h2>#}
    <h1 class="text-primary text-center mb-5"><b>Find Journals or Authors</b></h1>
    <div class="input-group-prepend mb-3 input-search" >
        <select id="valeselect" name="searchOption" class="form-control" style="border-radius: 24px;width:30%;height: 42px">
            <option value="journal">Journal</option>
            <option value="author">Author</option>
        </select>


        <input type="text" id="searchValue" name="searchValue"  style="height: 40px; font-size: large" class="form-control searchValue" placeholder="Full title, words, ISSN" aria-label="Title, word, ISSN" aria-describedby="texte-bouton">
        <span class="icon-search" >
            <i class="fa fa-search"></i>
        </span>

{#            <button class="btn btn-outline-info" type="submit" id="texte-bouton" style="width: 130px;height: 40px"><i class="fa fa-search"></i> Search</button>#}
        </div>


    <div class="row">

        <div class=" {% if (tpjlistScopus is defined and tpjlistScopus|length>0) or (data_t_scopus  is defined  and data_t_scopus|length>0) or (tpjlistWebof is defined and tpjlistWebof|length>0) %}col-sm-9{% else %}col-sm-11{% endif %}" style="text-align: right; margin-top: -15px;">
        <a href="{{ path('advanced_search_scopus_web_ofs') }}" > <b>Advanced search ?</b></a>
        </div>
    </div>

</form>

<script>
    $(function(){
        $("#valeselect").change(function(){
            if($(this).children("option:selected").val()=== "journal")
            {

                $('#searchValue').attr('placeholder','Title, word, ISSN');
            }else{
                $('#searchValue').attr('placeholder','Author Name');
            }
        });
    });


        $('.icon-search').on("click", function () {
        $('#searchValue').focus();
    })

</script>
