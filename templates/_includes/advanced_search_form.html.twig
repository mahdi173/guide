<div class="card">
    <div class="card-body">

<form method="get" action="{{ url('data__advanced_search_by_several_params') }}">
    <h3 class="text-primary"><b>Advanced Search</b></h3>
    <div class="input-group mb-3" >
        <div class="row">
            <div class="col-sm-8">
                <div class="row">
                    <div class="col-sm-6">
                        <label for="publisher"><b>Publisher</b></label>
                        <select class="form-control" id="publisher" name="name_of_publisher">
                            <option>All</option>
                            {% for lp in listpublishers %}
                                <option>{{ lp.publisher }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-sm-6">
                            <label for="subjectarea"><b>Subject Area</b></label>
                            <select class="form-control" id="subjectarea" name="subjectarea">
                                <option>All</option>
                                {% for lc in listcategories %}
                                <option>{{ lc.scopussubsubjectarea }}</option>
                                {% endfor %}

                            </select>
                    </div>
                        </div>
                <div class="row">
                    <div class="col-sm-12" style=" width: 100%; height: 250px; margin-top: 7px">
                        <!-- advanced_search -->
                        <ins class="adsbygoogle"
                             style="display:block"
                             data-ad-client="ca-pub-9897811061542650"
                             data-ad-slot="4598934100"
                             data-ad-format="auto"
                             data-full-width-responsive="true"></ins>
                        <script>
                            (adsbygoogle = window.adsbygoogle || []).push({});
                        </script>
                    </div>

                </div>

            </div>
            <div class="col-sm-4">
                        <div class="row col-sm-12">
                            <label for="openaccess"><b>Open Acess</b></label></div>
                                 <div class="row col-sm-12" style="margin-left: 30px">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="yes" value="yes" name="yes">
                                <label class="form-check-label" for="yes">Yes</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="no" value="no" name="no">
                                <label class="form-check-label" for="no">No</label>
                            </div>
                                 </div>
                        <hr>


                    <div class="row col-sm-12" style="text-align: center; width: 100%">
                    <label for="quartlle"><b>Quartlle</b></label></div>
                    <div class="row col-sm-12" style="margin-left: 30px">
                        <div class="row col-sm-6" style="text-align: center; width: 100%; ">
                            <div class="form-check form-check-inline col-sm-6" style="text-align: center">
                                <input class="form-check-input" type="checkbox" id="q1" value="Quartile 1" name="q1">
                                <label class="form-check-label" for="q1">Q1</label>
                            </div>
                        </div>
                        <div class="row col-sm-6">
                            <div class="form-check form-check-inline col-sm-6" style="text-align: center">
                                <input class="form-check-input" type="checkbox" id="q2" value="Quartile 2" name="q2">
                                <label class="form-check-label" for="q2">Q2</label>
                            </div>
                        </div>

                    </div>
                    <div class="row col-sm-12" style="margin-left: 30px">
                        <div class="row col-sm-6" >
                            <div class="form-check form-check-inline col-sm-6" >
                                <input class="form-check-input" type="checkbox" id="q3" value="Quartile 3" name="q3">
                                <label class="form-check-label" for="q3">Q3</label>
                            </div>
                        </div>
                        <div class="row col-sm-6">
                            <div class="form-check form-check-inline col-sm-6">
                                <input class="form-check-input" type="checkbox" id="q4" value="Quartile 4" name="q4">
                                <label class="form-check-label" for="q4">Q4</label>
                            </div>
                        </div>

                    </div>

                <hr>
                    <div class="row">
                    <div class="col-sm-6" style="text-align: center">
                        <label for="sjr" class="text-info"><b>SJR</b></label>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sjr_r" id="sjr_r" value="option1">
                                    <label class="form-check-label" for="sjr_r"> > </label>
                                    <input type="text" class="form-control" id="formGroupExampleInput" name="sjr_sup">
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="sjr_r" id="sjr_r1" value="option2">
                                    <label class="form-check-label" for="sjr_r1"> < </label>
                                    <input type="text" class="form-control" id="formGroupExampleInput" name="sjr_inf">
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-sm-6" style="text-align: center">
                        <label for="sjr" class="text-danger"><b>JCR</b></label>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="jcr_r" id="jcr_r1" value="option1">
                                    <label class="form-check-label" for="inlineRadio1"> > </label>
                                    <input type="text" class="form-control" id="formGroupExampleInput" name="jcr_sup">
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="jcr_r" id="jcr_r1" value="option2">
                                    <label class="form-check-label" for="inlineRadio2">  < </label>
                                    <input type="text" class="form-control" id="formGroupExampleInput" name="jcr_inf">
                                </div>
                            </div>
                        </div>

                    </div>
                        <hr style="width: 100%">
                        <div class="row col-sm-12" style="text-align: center">

                            <div class="input-group-append" style="text-align: center">
                                <button class="btn btn-outline-danger" type="submit" id="advanced-bouton" style=" text-align: center"><i class="fa fa-search text-info"></i> &nbsp; &nbsp; &nbsp; Search &nbsp; &nbsp; &nbsp;</button>
                            </div>
                        </div>
                    </div>


        </div>
        </div>

    </div>
</form>
    </div>
</div>