{% extends '@SuluCommunity/profile-form.html.twig' %}

{% block title %}GuideJournal: List journals{% endblock %}

{% block profile_content %}

    <table class="table table-striped">
        <thead>
        <tr>
            <th scope="col">Title</th>
            <th scope="col">Publisher</th>
            <th scope="col">Subject area</th>
            <th scope="col">journal url</th>
            <th scope="col">Action</th>
        </tr>
        </thead>
        <tbody>
        {% if favorite | length==0 %}
        <tr><td><p class=" alert font-weight-light text-muted "> no journal available !</p></td></tr>
        {% else %}
        {% for f in favorite %}
        <tr>
            <td>{{ f.title }}</td>
            <td>{{ f.publisher  }}</td>
            <td>{{ f.subjectArea|default('') }}</td>
            <td><a target="_blank" href="/journal/{{ f.eissn }}">URL</a></td>
            <td><a class="btn btn-danger" target="_blank" href="{{ path('switch_favorite', {id: f.id, 'source': 'reuters'?'scopus'}) }}"><i class="fa fa-remove"></i></a></td>
        </tr>
        {% endfor %}
        {% endif %}
        </tbody>
    </table>

{% endblock %}
