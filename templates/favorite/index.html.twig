{% extends '@SuluCommunity/profile-form.html.twig' %}

{% block title %}GuideJournal: List journals{% endblock %}

{% block profile_content %}

    <table class="table table-striped">
        <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Title</th>
            <th scope="col">Publisher</th>
            <th scope="col">Subsubject area</th>
            <th scope="col">journal url</th>
        </tr>
        </thead>
        <tbody>
        {% for f in favorite %}
        <tr>
            <th scope="row">{{ f.id }}</th>
            <td>{{ f.title }}</td>
            <td>{{ f.publisher }}</td>
            <td>{{ f.scopussubsubjectarea }}</td>
            <td><a href="{{ f.scopussourceid }}">URL</a></td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
