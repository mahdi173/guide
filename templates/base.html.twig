<div class="container container-base">
    <div class="row">
        <div class="col-lg-4">
            <h2 class="my-0 mr-md-auto text-info">
                <a class="navbar-brand" href="/">
                    <img class="img-fluid logo-gj" src="{{ asset('assets/images/refonte/logo.svg') }}" alt="ResearchGuide"  />
                </a>
            </h2>
        </div>
        <div class="col-lg-8">
            <div class="row row-nav">
                <div class="col-lg-8 text-right">
                    <nav class="my-2 my-md-0 mr-md-3">
                        <div class="container right_nav">
                            {#            <a  href="/" class="p-2 text-dark">Home <span class="sr-only">(current)</span></a>#}
                            {#            <a href="/aboutguidejournal" class="p-2 text-dark">About</a>#}
                            {#            <a href="/contactguidejournal" class="p-2 text-dark">Contact</a>#}
                            {#            <a href="/blog" class="p-2 text-dark">Blog</a>#}
                            {#            <a href="/scopus/topjournallist" class="p-2 text-dark">Top journals list</a>#}
                            <a  href="/" class="p-2 text-dark">Home <span class="sr-only">(current)</span></a>
                            <a  href="{{ path('journalSearch') }}" class="p-2 text-dark">Journal search <span class="sr-only"></span></a>
                            <a  href="{{ path('get_authors') }}" class="p-2 text-dark">Author search <span class="sr-only"></span></a>
                            {#            <a  href="{{ path('graphic_data') }}" class="p-2 text-dark">Graph Maker  <span class="sr-only"></span></a>#}
                            {#            <a  href="#" class="p-2 text-dark">Blog  <span class="sr-only"></span></a>#}
                            {%  if  sulu_navigation_root_tree is defined %}
                                {% for item in sulu_navigation_root_tree('main') %}
                                    <a href="{{ sulu_content_path(item.url, item.webspaceKey) }}" class="p-2 text-dark"
                                       title="{{ item.title }}">{{ item.title }}</a>
                                {% endfor %}
                            {% endif %}

                        </div>
                    </nav>
                </div>
                <div class="col-lg-4 ">
                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                        <li class="dropdown" style=" list-style-type: none;color:black ">
                            {#                    <a class="dropdown-toggle" href="{{ path('favorite_list')}}" data-toggle="dropdown">{{app.user.firstName}} <span class="caret"></span></a>#}
                            {% set media = null %}
                            {% set src = null %}
                            {% if app.user.contact.avatar is not null %}
                                {% set media = sulu_resolve_media(app.user.contact.avatar,'fr') %}
                            {% endif %}

                            {% if media is not null %}
                                {% set src= media.url %}
                            {% else %}
                                {% set src=  asset('assets/images/profil_new.jpg') %}
                            {% endif %}


                            <a class="dropdown-toggle" href="#" data-toggle="dropdown">

                                <img class="rounded-circle" src="{{ src }}" width="50" height="50" alt="{{ app.user.firstName}} {{ app.user.lastName}}"/>

                                <span class="caret"></span>
                            </a>
                            {#                    <a class="dropdown-toggle" href="#" data-toggle="dropdown">{{app.user.firstName}} <span class="caret"></span></a>#}


                            <ul  class="dropdown-menu dropdown-menu-right" style="margin-top: 36px;">
                                <li ><a class="dropdown-item" href="{{ path('author_search')}}">My profile</a></li>
                                {#                        <li ><a class="dropdown-item" href="{{ path('sulu_community.profile')}}">Your profile</a></li>#}
                                <div class="dropdown-divider"></div>
                                <li><a  class="dropdown-item" href="{{ path('settings') }}">Account settings</a></li>
                                {#                        <div class="dropdown-divider"></div>#}
                                {#                        <li><a  class="dropdown-item" href="#">Help center</a></li>#}
                                <div class="dropdown-divider"></div>
                                <li><a  class="dropdown-item" href="{{ path('sulu_community.logout') }}">Log out</a></li>
                            </ul>
                        </li>

                    {% else %}
                        <div class="sign float-right">
                            <a class="btn btn-outline-warning sign-in" href="{{ path('sulu_community.login')}}">Sign in</a>
                            <a class="btn btn-warning ml-2 sign-up" href="{{ path('sulu_community.registration')}}">Sign up</a>
                        </div>


                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
