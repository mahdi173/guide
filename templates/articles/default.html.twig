{% extends "base.html.twig" %}

{% block meta %}
    {% include "SuluWebsiteBundle:Extension:seo.html.twig" with {
        "seo": extension.seo|default([]),
        "content": content|default([]),
        "urls": urls|default([]),
        "shadowBaseLocale": shadowBaseLocale|default(),
        "defaultLocale": request.defaultLocale|default('de')
    } %}
{% endblock %}
{% block title %}{{ content.title }} | {{ parent() }}{% endblock %}
{% block content %}

    <div class="row">

        <!-- Post Content Column -->
        <div class="col-lg-8">
            <!-- Title -->
            <h1 class="mt-4">{{ content.title }}</h1>

            <hr>

            <!-- Preview Image -->
            {% if content.video %}
                <div class="embed-responsive embed-responsive-16by9">
                    <iframe class="embed-responsive-item" src="{{ content.video }}?rel=0" allowfullscreen title="content"></iframe>
                </div>
            {% elseif content.image %}
                <img class="img-fluid rounded" src="{{ sulu_get_media_url(content.image) }}" alt="">
            {% else %}
                <img class="img-fluid rounded" src="{{ asset('assets/images/Guidejournal.png') }}" alt="">
            {% endif %}

            <hr>

            {% for tag in content.tags %}
                <span class="badge badge-primary">{{ tag }}</span>
            {% endfor %}

            <!-- Post Content -->
            {% if content.article %}
                <p> {{ content.article|default()|raw }} </p>
            {% else %}
                <p></p>
            {% endif %}
            {# les blocks ajouter pendant la création de l'article #}
{#            {% include '_includes/blocks.html.twig' with { blocks: content.blocks } %}#}

            <div class="sharethis-inline-share-buttons"></div>

            <div id="disqus_thread"></div>

        </div>

        <!-- Sidebar Widgets Column -->
        <div class="col-md-4">

            <!-- Search Widget -->
            <div class="card my-4">
                <h5 class="card-header">Search</h5>
                <div class="card-body">
                    <form action="{{ path('sulu_search.website_search') }}" method="get">
                        <div class="input-group">
                            <input name="q" type="text" class="form-control" placeholder="Search for..." />
                            <span class="input-group-btn"><button class="btn btn-secondary" type="submit">Go !</button></span>

                        </div>
                    </form>
                </div>
            </div>

            <!-- Categories Widget -->
            <div class="card my-4">
                <h5 class="card-header">Categories</h5>
                <div class="card-body">
                    <div class="row">
                        {% for categorie in content.categories %}
                            <div class="col-lg-6">
                                <ul class="list-unstyled mb-0">


                                    <li>
                                        <a href="#"> {% if categorie.name %} {{ categorie.name }} {% endif %}</a>
                                    </li>


                                </ul>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Side Widget -->
            {#            <div class="card my-4">#}
            {#                <h5 class="card-header">Side Widget</h5>#}
            {#                <div class="card-body">#}
            {#                    You can put anything you want inside of these side widgets. They are easy to use, and feature the new Bootstrap 4 card containers!#}
            {#                </div>#}
            {#            </div>#}

        </div>

    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>

        /**
         *  RECOMMENDED CONFIGURATION VARIABLES: EDIT AND UNCOMMENT THE SECTION BELOW TO INSERT DYNAMIC VALUES FROM YOUR PLATFORM OR CMS.
         *  LEARN WHY DEFINING THESE VARIABLES IS IMPORTANT: https://disqus.com/admin/universalcode/#configuration-variables*/
        /*
        var disqus_config = function () {
        this.page.url = PAGE_URL;  // Replace PAGE_URL with your page's canonical URL variable
        this.page.identifier = PAGE_IDENTIFIER; // Replace PAGE_IDENTIFIER with your page's unique identifier variable
        };
        */
        (function() { // DON'T EDIT BELOW THIS LINE
            var d = document, s = d.createElement('script');
            s.src = 'https://guidejournal.disqus.com/embed.js';
            s.setAttribute('data-timestamp', +new Date());
            (d.head || d.body).appendChild(s);
        })();
    </script>
    <script type='text/javascript' src='https://platform-api.sharethis.com/js/sharethis.js#property=5e1ef322734b56001269b6b7&product=inline-share-buttons' async='async'></script>
    <noscript>Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>

{% endblock %}
