{% extends 'base.html.twig' %}

{% block body %}
    <style>
        .IN-widget{
            position: relative;
            bottom: 2px;
        }
        .IN-widget button{
            height: 21px !important;
        }
        .fb-share-button{
            height: 21px;
            width: 55px;
            display: inline-block;
            margin: 5px;
        }
        ol.carousel-indicators li {
            background: rgba(225, 227, 221, 0.54);

        }

        ol.carousel-indicators li.active {
            background: #2ebae6;
        }
    </style>
    <!-- Load Facebook SDK for JavaScript -->
    <div id="fb-root"></div>
    <script>
        (function(d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v3.0";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
    </script>

    <!--style="background-color: #f6f6f6"-->
    <div class="container-fluid mr-0 ml-0 pr-0 pl-0" style="margin-top: -1%">
        <div class="card card-results">
            <div class="card-body">

                <div class="row mt-5">
                    <div class="col-sm-12"> </div>
                    <div class="col-md-2 col-sm-1"></div>
                    <div class="col-md-8">
                        {% include '_includes/search_form.html.twig' %}
                    </div>
                    <div class="col-md-2 col-sm-1"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row" style="margin-top: 1.8rem;">

        <div class="col-sm-12"></div>

    </div>
    <div class="container-fluid search-journals-result" >

        <div class="row" >
            <div class="col-md-2 col-sm-2"></div>
            <div class="col-md-8">
                <h3 class="text-center text-uppercase">
                    <b>{{ journals|length }} journal(s) matched your search</b></h3>

                <br>
                {% if journals|length %}
                <table class="table mb-5">

                    <thead>
                    <tr>
                        <th scope="col" class="th-journal">JOURNAL NAME</th>
                        <th scope="col">PUBLISHER</th>
                        <th scope="col">OPEN ACCESS </th>
                        <th scope="col">E-ISSN</th>
                    </tr>
                    <tbody>
                    {% for journal in journals %}
                    <tr class="table-data">
                        <th scope="row" class="jounal-title">
                            <a href="{{ path('journal_show', {'id': journal.id}) }}" target="_blank">{{ journal.title }}</a>
                        </th>
                        <td>   {% if journal.contributor %}{{ journal.contributor.firstName  }}  {{ journal.contributor.lastName  }}{% endif %}</td>
                        <td> {{ journal.isOpenAccess ? 'YES' : 'NO' }}</td>
                        <td>{% if journal.originalEISSN %}{{ journal.eissn }}{% endif %}</td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <table class="table mb-5">
                    <thead>
                    <tr>
                        <th scope="col">No results found for {{ app.request.get('searchValue')|upper}} !</th>
                    </tr>
                    </thead>
                </table>
                {% endif %}

