                    <input type="text" name="title[]" value="Title" class="form-control title"><br>
                </div>
                <div class="input-group mb-3">
                    <input type="color" name="color[]" class="form-control color"/>
                </div>
            </div>
            <i class="fa fa-times delete_colis_row" style="color: #EC3A1B"></i>
        </div>
    </div>
