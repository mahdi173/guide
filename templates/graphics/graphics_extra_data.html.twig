<script>
$(document).ready(function () {

    function displayInlineDate(selector){
        const dataConvertY = [];
        var value=($(selector).val()).split(',')
        for(var i=0;i<value.length;i++) {
            dataConvertY.push(value[i])
        }
        $(selector).val(dataConvertY.join("\n"))

        dinamicHeightTextarea(selector);
    }
    $('#dataExtraText').bind('change propertychange', function() {
        displayInlineDate('#dataExtraText')
        console.log( $(this))
        $(this).height = "1px";
        $(this).height = (55+$('#dataExtraText').scrollHeight)+"px";

    });
    $('.nombre1').bind('change propertychange', function() {
        displayInlineDate('.nombre1')
    });
    $('.nombre2').bind('change propertychange', function() {
        displayInlineDate('.nombre2')
    });
    function dinamicHeightTextarea(selector){
        let textareas = document.querySelectorAll(selector),
            hiddenDiv = document.createElement('div'),
            content = null;

        for (let j of textareas) {
            j.classList.add('txtstuff');
        }
        hiddenDiv.classList.add('txta'+selector);
        hiddenDiv.style.display = 'none';
        hiddenDiv.style.whiteSpace = 'pre-wrap';
        hiddenDiv.style.wordWrap = 'break-word';

        for(let i of textareas) {
            (function(i) {

                i.addEventListener('input', function() {
                    i.parentNode.appendChild(hiddenDiv);
                    i.style.resize = 'none';
                    i.style.overflow = 'hidden';
                    content = i.value;
                    content = content.replace(/\n/g, '<br>');
                    hiddenDiv.innerHTML = content + '<br style="line-height: 3px;">';
                    hiddenDiv.style.visibility = 'hidden';
                    hiddenDiv.style.display = 'block';
                    i.style.height = hiddenDiv.offsetHeight + 'px';

                    hiddenDiv.style.visibility = 'visible';
                    hiddenDiv.style.display = 'none';
                });
            })(i);
        }
    }

    /*f*/
    $("#dataExtraText").focusout(function() {
        dinamicHeightTextarea("#dataExtraText");
    });



    /*f*/
    if(localStorage.getItem('axe1')) {


        var axe1 = localStorage.getItem('axe1');
        var axe2 = localStorage.getItem('axe2');
        var axe3 = localStorage.getItem('axe3');

       var colors=localStorage.getItem('colors')
       var titles=localStorage.getItem('titles')


        var arrayAxe1 = JSON.parse(axe1);
        var arrayAxe2 = JSON.parse(axe2);
        var arrayAxe3 = JSON.parse(axe3);
        var item_colors=JSON.parse(colors)
        var arrayTitles = JSON.parse(titles);


        var a1 = JSON.parse(arrayAxe1);
        var a2 = JSON.parse(arrayAxe2);
       var a3 = JSON.parse(arrayAxe3);
        var itemArray_colors=JSON.parse(item_colors)
        var t1 = JSON.parse(arrayTitles);
console.log(itemArray_colors)
console.log(t1)

        $('.nombre0').val(a1.join('\n'));
        $('.nombre1').val(a2.join('\n'));
        if(a3.length>0){
             $('.nombre2').val(a3.join('\n'));
        }


        $('.color0').val(itemArray_colors[0])
        $('.color1').val(itemArray_colors[1])
        $('.color2').val(itemArray_colors[2])

        $('.title0').val(t1[0])
        $('.title1').val(t1[1])
        $('.title2').val(t1[2])



    }
})
</script>