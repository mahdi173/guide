            <div class="form-group">
                <label class="label" style="font-weight:bold;">data y</label><br>

                <div class="input-group mb-3">
                    <textarea  name="dataExtra[]" id="dataExtraText" data-number="0" class="form-control nombre" rows="8" cols="10"></textarea><br>
                </div>
                <div class="input-group mb-3">
                    <input type="text" name="title[]" value="Title" class="form-control title"><br>
