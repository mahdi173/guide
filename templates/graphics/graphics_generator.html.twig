    <script>
        $( document ).ready(function() {
            $('.selectGrid option[value="{{ showGrid }}"]').attr("selected", true);
            $('#graphic_edit_type option[value="{{ type }}"]').attr("selected", true);
          if(border){
              $(".newBorder").prop( "checked", true );
          }
          if(roundCorner){
              $(".newBorderRadius").prop( "checked", true );
          }

            $('.newTitle').change(function() {
                updateConfigByMutating(myChart)
            })
            $('.newAxeY').change(function() {
                updateAxeY(myChart)
            })
            $('.newAxeX').change(function() {
                updateAxeX(myChart)
            })
            $('#graph_gridLine').change(function() {
                updateType(myChart)
            })
            $('.gridColor').change(function() {
                updateType(myChart)
            })
            $('#graphic_edit_type').change(function() {

                var editType=$('#graphic_edit_type').val()
                change(editType)
            })
            $('.titleColor').change(function() {
                updateTitleColor(myChart)
            })
            $('.newBorder').change(function() {
                var newBorder=( $('.newBorder').is(':checked') )
                if(newBorder){
                    $('#myChart').css("border", "1px solid black")
                }
               else{ $('#myChart').css("border", "none")}
                myChart.update();
            })
            $('.newBorderRadius').change(function() {
                var newBorder=( $('.newBorderRadius').is(':checked') )
                if(newBorder){
                    $('#myChart').css("border-radius", "10px")
                }
               else{ $('#myChart').css("border-radius", "0px")}
                myChart.update();
            })
            $('.graphBackgroundColor').change(function() {
                $('#myChart').css("backgroundColor", $('.graphBackgroundColor').val())
                myChart.update();
            })
            $('.newWidth').change(function() {
                $('#myChart').css("width", $('.newWidth').val())
                myChart.update();
            })
            $('.newHeight').change(function() {
                $('#myChart').css("height", $('.newHeight').val())
                myChart.update();
            })
            function updateConfigByMutating(chart) {
                chart.options.title.text =  $('.newTitle').val();
                chart.update();
            }
            function updateAxeY(chart) {

                chart.options.scales.yAxes[0].scaleLabel.labelString =  $('.newAxeY').val();
                chart.update();
            }
            function updateAxeX(chart) {
                chart.options.scales.xAxes[0].scaleLabel.labelString =  $('.newAxeX').val();
                chart.update();
            }
            function updateTitleColor(chart) {
                chart.options.title.fontColor =  $('.titleColor').val();
                chart.update();
            }
            function updateType(chart) {
                if(  $('#graph_gridLine').val()==="vertical"){
                    chart.options.scales.xAxes[0].gridLines.display=true;
                    chart.options.scales.yAxes[0].gridLines.display=true;
                    chart.options.scales.yAxes[0].gridLines.color=false;
                    chart.options.scales.xAxes[0].gridLines.color=$('.gridColor').val();

                }
                if(  $('#graph_gridLine').val()==="horizental"){
                    chart.options.scales.yAxes[0].gridLines.display=true;
                    chart.options.scales.xAxes[0].gridLines.display=true;
                    chart.options.scales.xAxes[0].gridLines.color=false;
                    chart.options.scales.yAxes[0].gridLines.color=$('.gridColor').val();

                }
                if( $('#graph_gridLine').val()==="none"){
                    chart.options.scales.yAxes[0].gridLines.display=false;
                    chart.options.scales.yAxes[0].gridLines.color=$('.graphBackgroundColor').val();
                    chart.options.scales.xAxes[0].gridLines.color=$('.graphBackgroundColor').val();

                }
                if( $('#graph_gridLine').val()==="both"){
                    chart.options.scales.xAxes[0].gridLines.display=true;
                    chart.options.scales.xAxes[0].gridLines.color=$('.gridColor').val();
                    chart.options.scales.yAxes[0].gridLines.display=true;
                    chart.options.scales.yAxes[0].gridLines.color=$('.gridColor').val();

                }
                chart.update();
            }

        })
