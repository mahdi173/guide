        var widths='{{ width }}'
        var height='{{ height }}'

        var ctx = document.getElementById('myChart').getContext('2d');
        let elem = document.getElementById('myChart');

        console.log(widths,height)
        if(widths){
            // ctx.canvas.width=200
            ctx.canvas.width=widths
        }else{
            ctx.canvas.width=700
        }

        if(height){
            ctx.canvas.height=height
        }else{
            ctx.canvas.height=700
        }
        var chart = document.getElementById('myChart');

        var border='{{ border }}'
        var roundCorner='{{ roundCorner }}'
        var graphBackgroundColor='{{ graphBackgroundColor }}'

        if(graphBackgroundColor){
            // $('#myChart').css('backgroundColor',graphBackgroundColor)
            $('#myChart').css('backgroundColor',$('.graphBackgroundColor').val())

        }


        if(border){
            $('#myChart').css('border','1px black solid')
            $('#myChart').css('padding','30px 40px 30px 5px')
        }
         else{
            $('.buttons').css('margin-left','65px')
            $('.visualize').css('margin-left','65px')

        }
        if(roundCorner){
            $('#myChart').css('border-radius','10px')
        }


        var config = {
                type: '{{type}}',
                data:getDataChart(type),
                options: getConfigChart(type)
                // options: options
            };

        var myChart = new Chart(ctx, config);



