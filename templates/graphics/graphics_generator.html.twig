{% extends "base.html.twig" %}
{% block title %}GuideJournal - Graphics generator{% endblock %}
{% block stylesheets %}
<style>
    #myChart{

        margin-top: 20px;
        margin-left: 50px;
        width:700px !important;
        height:500px !important;
        background-color: white !important;

    }
    #bar,#line,#pie:hover{
        cursor: pointer;

    }
    #bar,#line,#pie{
       color:#0d70f2

    }
</style>
{% endblock %}
{% block content %}
    <div class="row" style="margin-top: 50px">
        <div class="offset-3 col-md-9">
           <h3 style="margin-left: 40px;font-weight: bold">{{ graphicTitle }}</h3>
       </div>
    </div>

    <div class="row">
        <canvas id="myChart" width="100" height="100"></canvas>
    </div>
    <div class="row visualize" style="margin-left: 40px;margin-top: 50px">
       <p style="font-weight: bold">Visualize chart as  <a id="bar"  style="margin-left: 10px">Bar</a> <a id="pie"  style="margin-left: 10px">Pie</a> <a id="line" style="margin-left: 10px">Line</a></p>
    </div>
    <br><div class="row buttons" style="margin-left: 40px;margin-top: 10px">
        <a href="#" id="downloadPdf" class="btn btn-warning" style="padding: 15px;color:white;margin-right: 15px">download pdf</a>
        <a href="#" id="downloadJpg" class="btn btn-warning" style="padding: 15px;color:white;margin-right: 15px">download jpg</a>
        <a href="#" id="downloadTif" class="btn btn-warning" style="padding: 15px;color:white;margin-right: 15px">download tif</a>
        <a href="#" id="downloadPic" class="btn btn-warning" style="padding: 15px;color:white;margin-right: 15px">download png</a>
        <a href="#" id="editGraph" class="btn btn-warning" style="padding: 15px;color:white;margin-right: 15px" >Edit graph</a>
{#        <a href="#" id="downloadPic" class="btn" style="padding: 20px;background-color: #B22222;color:white">download image</a>#}

    </div>

{% endblock  %}

{% block javascripts %}
   <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.min.js"></script>
   <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.5.3/jspdf.min.js"></script>
    <script src="/scripts/FileSaver.js"></script>


    <script>
        var newT=''
        console.log(newT)
        var hasMultipleY='{{ hasMultipleY }}'
        console.log(hasMultipleY,"hasMultipleY");
        var showValues='{{ showValues }}';
        var type='{{ type }}';
        var showGrid='{{ showGrid }}';
        var countDataExtra='{{ dataExtra|length }}';

        var countColors='{{axe2|json_encode()|raw}}';
        var aa='{{aa|json_encode()|raw}}';

        var ctx = document.getElementById('myChart').getContext('2d');
        var chart = document.getElementById('myChart');

        var border='{{ border }}'
        var roundCorner='{{ roundCorner }}'
        if(border){
            $('#myChart').css('border','1px black solid')
            $('#myChart').css('padding','30px')
        }
         else{
            $('.buttons').css('margin-left','65px')
            $('.visualize').css('margin-left','65px')

        }
        if(roundCorner){
            $('#myChart').css('border-radius','10px')
        }
        var options={
            responsive: true,
            legend: {

                display: false,

            },
            "hover": {
                "animationDuration": 0
            },

            "animation": {
                "duration": 1,
                "onComplete":

                    function () {
                        if (showValues) {
                            var chartInstance = this.chart,
                                ctx = chartInstance.ctx;

                            ctx.font = Chart.helpers.fontString(25, Chart.defaults.global.defaultFontStyle, Chart.defaults.global.defaultFontFamily);
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'bottom';
                            if (type !== "pie"){

                                this.data.datasets.forEach(function (dataset, i) {
                                    var meta = chartInstance.controller.getDatasetMeta(i);
                                    meta.data.forEach(function (bar, index) {
                                        var data = dataset.data[index];
                                        ctx.fillText(data, bar._model.x, bar._model.y - 5);

                                    });
                                });
                            }
                            else {
                                this.data.datasets.forEach(function (dataset) {

                                    for (var i = 0; i < dataset.data.length; i++) {
                                        var model = dataset._meta[Object.keys(dataset._meta)[0]].data[i]._model,
                                            total = dataset._meta[Object.keys(dataset._meta)[0]].total,
                                            mid_radius = model.innerRadius + (model.outerRadius - model.innerRadius)/2,
                                            start_angle = model.startAngle,
                                            end_angle = model.endAngle,
                                            mid_angle = start_angle + (end_angle - start_angle)/2;

                                        var x = mid_radius * Math.cos(mid_angle);
                                        var y = mid_radius * Math.sin(mid_angle);

                                        ctx.fillStyle = '#fff';
                                        if (i == 3){ // Darker text color for lighter background
                                            ctx.fillStyle = '#444';
                                        }
                                        var percent = String(Math.round(dataset.data[i]/total*100)) + "%";
                                        //Don't Display If Legend is hide or value is 0
                                        if(dataset.data[i] != 0 && dataset._meta[0].data[i].hidden != true) {
                                            ctx.fillText(dataset.data[i], model.x + x, model.y + y);
                                            // Display percent in another line, line break doesn't work for fillText
                                            //   ctx.fillText(percent, model.x + x, model.y + y + 15);

                                        }
                                    }
                                });
                            }
                        }

                    }

            },
            tooltips: {
                callbacks: {
                    label: function(tooltipItem) {
                        return tooltipItem.yLabel;
                    }
                }
            },
            scales: {
                yAxes: [{
                    ticks: {
                        display: type!=="pie"?true:false,
                        beginAtZero: true,
                        fontSize: 25
                    },
                    scaleLabel: {
                        display: type!=="pie"?true:false,
                        labelString: '{{titleY}}',
                        fontSize:33,
                        fontStyle:"bold"
                    },
                    gridLines:{
                        display: type!=="pie"?true:false,
                        // color:"rgb(32, 35, 11)",
                        color:showGrid?"rgb(32, 35, 11)":null,
                    }
                }],
                xAxes: [{
                    ticks: {
                        display: type!=="pie"?true:false,
                        fontSize: 25
                    },
                    scaleFontSize: 40,
                    scaleLabel: {
                        display: type!=="pie"?true:false,
                        labelString: '{{titleX}}',
                        fontSize:33,
                        fontStyle:"bold"
                    },
                    gridLines:{
                        display: type!=="pie"?true:false,
                        //display:false,

                        color:showGrid?"rgb(32, 35, 11)":null,

                    }
                }]
            },
            {#title: {#}
            {#    fontSize: 36,#}
            {#    paddingBottom: 50,#}
            {#    display: true,#}
            {#     text: '{{graphicTitle}}'#}
            {#}#}
        }
        var data={
            labels: ({{axeX|json_encode()|raw}}),
            datasets:  parseInt(countDataExtra)===0?[{
                    data: ({{axeY|json_encode()|raw}}),
                    backgroundColor: '{{color}}'!=='#000000'?'{{color}}':[ "#ff6766","#81ff81","#6665fe","#ffff80","#ff66ff","#ccffff","#A2B4B5","#E2E47D","#E8839C"],
                        {#borderColor: '{{color}}',#}
                    fill:  type!=="line" || newT!=="line" ?true:false,
                    borderColor: type==="line"?'{{ color }}':false,
                    lineTension: 0.4,
                    borderJoinStyle: 'miter',
                    borderWidth:  type==="line"?5:false,
                    pointBorderWidth: 5,
                }]:
                [

                    {
                        type: '{{ type }}',
                        label: 'a0',
                        id: "y-axis-10",
                        backgroundColor: '{{color}}'!=='#000000'?'{{color}}':[ "#ff6766","#81ff81","#6665fe","#ffff80","#ff66ff","#ccffff","#A2B4B5","#E2E47D","#E8839C"],
                        data: ({{axeY|json_encode()|raw}}),
                        fill:  type!=="line"?true:false,
                        borderColor: type==="line"?'{{ color }}':false,
                        lineTension: 0.4,
                        borderJoinStyle: 'miter',
                        pointBorderWidth: 5,
                    }
                    ,
                    //  parseInt(countDataExtra)>=1?(
                    {

                        type: '{{ type }}',
                        label: 'a',
                        id: "y-axis-20",
                        backgroundColor: '{{color1}}'!=='#000000'?'{{color1}}':["#8e5ea2","#3cba9f","#e8c3b9","#c45850","#FF5733","#E397F2","#A2B4B5","#E2E47D","#E8839C"],
                        data: ({{ axe1|json_encode()|raw }}),
                        fill:  type!=="line"?true:false,
                        borderColor: type==="line"?'{{ color1 }}':false,
                        borderJoinStyle: 'miter',
                        pointBorderWidth: 5,
                    },
                    //  ):null,
                    parseInt(countDataExtra)>=1?(
                        {

                            type: '{{ type }}',
                            label: 'b',
                            id: "y-axis-30",
                            backgroundColor: '{{color2}}'!=='#000000'?'{{color2}}':["#A2B4B5","#6665fe","#81ff81","#ccffff","#ff66ff","#ff66ff","#ff6766","#E8839C","#A2B4B5"],
                            data: ({{ axe2|json_encode()|raw }}),
                            fill:  type!=="line"?true:false,
                            borderColor: type==="line"?'{{ color2 }}':false,
                            borderJoinStyle: 'miter',
                            pointBorderWidth: 5,


                        }):null
                    ,{
                    type: '{{ type }}',
                    label: 'c',
                    id: "y-axis-40",
                    backgroundColor: '{{color3}}'!=='#000000'?'{{color3}}':[ "#8e5ea2","#3cba9f","#e8c3b9","#c45850","#FF5733","#E397F2","#A2B4B5","#E2E47D","#E8839C"],
                    data: ({{axe3|json_encode()|raw}}),
                    fill:  type!=="line"?true:false,
                    borderColor: type==="line"?'{{ color3 }}':false,
                    borderJoinStyle: 'miter',
                    pointBorderWidth: 5,
                }
                    //) :''

                ],

        }
        var config = {
                type: newT.length!==0 ? newT:'{{type}}',
                data: data,
                options: options
            };

        var myChart = new Chart(ctx, config);



    $('#downloadPic').click(function(event) {

        var canvas = document.getElementById('myChart');
        var ctx = canvas.getContext('2d');
        ctx.globalCompositeOperation = 'destination-over';
        ctx.fillStyle = 'white';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        var image = document.getElementById("myChart").toDataURL("image/png",1).replace("image/png", "image/octet-stream");
        $("#downloadPic").attr("href", image);
        $("#downloadPic").attr("download", "{{graphicTitle}}.png");

    })

        $('#downloadJpg').click(function(event) {

            var canvas = document.getElementById('myChart');
            var ctx = canvas.getContext('2d');
            ctx.globalCompositeOperation = 'destination-over';
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            var image = document.getElementById("myChart").toDataURL("image/jpeg",1).replace("image/jpeg", "image/octet-stream");
            $("#downloadJpg").attr("href", image);
            $("#downloadJpg").attr("download", "{{graphicTitle}}.jpg");

        })

        $('#downloadTif').click(function(event) {

            var canvas = document.getElementById('myChart');
            var ctx = canvas.getContext('2d');
            ctx.globalCompositeOperation = 'destination-over';
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            var image = document.getElementById("myChart").toDataURL("image/tiff",1).replace("image/tiff", "image/octet-stream");
            $("#downloadTif").attr("href", image);
            $("#downloadTif").attr("download", "{{graphicTitle}}.tiff");

        })

    $('#downloadPdf').click(function(event) {

        var canvas = document.getElementById('myChart');
        var canvasImg = canvas.toDataURL("image/png", 1);
        var doc = new jsPDF('landscape');
        doc.setFontSize(20);
        doc.addImage(canvasImg, 'PNG', 10, 30, 280, 150 );
        var title='{{graphicTitle}}';
        doc.save(title+'.pdf');
    });

        $( document ).ready(function() {
            const data={type:'{{ type }}',titleX:'{{ titleX }}',titleY:'{{ titleY }}',graphicTitle:'{{ graphicTitle }}',showValues:'{{ showValues }}',showGrig:'{{ showGrid }}',border:'{{ border }}',roundCorner:'{{ roundCorner }}',color:'{{ color }}'};
            const ar1='{{axeX|json_encode()|raw}}';
            const ar2='{{axeY|json_encode()|raw}}';
            const axe1='{{axe1|json_encode()|raw}}';
            const axe2='{{axe2|json_encode()|raw}}';
            const axe3='{{axe3|json_encode()|raw}}';
            const dataExtra='{{dataExtra|json_encode()|raw}}';
            const titles='{{titles|json_encode()|raw}}';
            const colors='{{colors|json_encode()|raw}}';
            const dataX=ar1;
            const  dataY=ar2;

            localStorage.setItem('dataObject', JSON.stringify(data));
            localStorage.setItem('dataX', JSON.stringify(dataX));
            localStorage.setItem('dataY', JSON.stringify(dataY));
            localStorage.setItem('dataExtra', JSON.stringify(dataExtra));
            localStorage.setItem('axe1', JSON.stringify(axe1));
            localStorage.setItem('axe2', JSON.stringify(axe2));
            localStorage.setItem('axe3', JSON.stringify(axe3));
            localStorage.setItem('titles', JSON.stringify(titles));
            localStorage.setItem('colors', JSON.stringify(colors));

        });
        $('#editGraph').click(function () {
            location.href="?edit=1";
        })

        var myChartt;
        $("#line").click(function() {
            newT='line'
            change('line');

        });

        $("#bar").click(function() {
            newT='bar'
            change('bar');
        });
        $("#pie").click(function() {
            newT='pie'
            change('pie');
        });
        function change(newType) {

            myChart.destroy();

            var config = {
                type: newType,
                data: data,
                //data.dataset.fill

                options: options
            };
            myChart = new Chart(ctx,config)



        };

    </script>
{% endblock %}