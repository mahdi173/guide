   <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.min.js"></script>
   <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.5.3/jspdf.min.js"></script>
    <script src="{{ asset('assets/js/canvastotiff.min.js') }}" ></script>

    <script src="/scripts/FileSaver.js"></script>

    <script src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>


    <script>
        $( document ).ready(function() {
            // setting pie chart
            $('.pieTitle1').change(function() {

                updateTitlePie(chart1,$('.pieTitle1').val())
            })
            $('.pieTitle2').change(function() {

                updateTitlePie(chart2,$('.pieTitle2').val())
            })
            $('.pieTitle3').change(function() {

                updateTitlePie(chart3,$('.pieTitle3').val())
            })
            $('.pieTitle4').change(function() {

                updateTitlePie(chart4,$('.pieTitle4').val())
            })
            // titleCart
            $('.pieTitleColor1').change(function() {

                updateTitleColorPie(chart1,$('.pieTitleColor1').val())

            })
            $('.pieTitleColor2').change(function() {

                updateTitleColorPie(chart2,$('.pieTitleColor2').val())
            })
            $('.pieTitleColor3').change(function() {

                updateTitleColorPie(chart3,$('.pieTitleColor3').val())
            })
            $('.pieTitleColor4').change(function() {

                updateTitleColorPie(chart4,$('.pieTitleColor4').val())
            })
            //backgroundColor
            $('.pieColor1').change(function() {
                updateBackGroundPie(chart1, $('.pieColor1').val())
            })
            $('.pieColor2').change(function() {
                updateBackGroundPie(chart2, $('.pieColor2').val())
            })
            $('.pieColor3').change(function() {
                updateBackGroundPie(chart3, $('.pieColor3').val())
            })
            $('.pieColor4').change(function() {
                updateBackGroundPie(chart4, $('.pieColor4').val())
            })
            //border pies
            $('.pieBorder1').change(function() {
                borderPie(chart1,"#chartContainer",'.pieBorder1')
            })
            $('.pieBorder2').change(function () {
                borderPie(chart2,"#chartContainer2",'.pieBorder2')
            })
            $('.pieBorder3').change(function () {
                borderPie(chart3,"#chartContainer3",'.pieBorder3')
            })
            $('.pieBorder4').change(function () {
                borderPie(chart4,"#chartContainer4",'.pieBorder4')
            })

           function borderPie(chart,chartId,checkboxClass) {
               var newBorder=( $(checkboxClass).is(':checked') )
               if(newBorder){
                   $( chartId+" canvas:nth-child(2)" ).css( "border", "2px solid grey" );
                   // $( chartId+" canvas:nth-child(1)" ).css( "padding-top", "12px" );
                   // $( chartId+" canvas:nth-child(2)" ).css( "padding-top", "12px" );
                   // $( chartId+" canvas:nth-child(2)" ).css( "padding-bottom", "12px" );

               }
               else{  $( chartId+" canvas:nth-child(2)").css('border',"none")
                   // $( chartId+" canvas:nth-child(1)" ).css( "padding-top", "0px" );
                   // $( chartId+" canvas:nth-child(2)" ).css( "padding-bottom", "0px" );
               }
               chart.render();
           }

            function updateTitlePie(chart,value) {
                chart.options.title.text = value ;
                chart.render();
            }
            function updateBackGroundPie(chart,value) {
                chart.options.backgroundColor = value ;
                chart.render();
            }
            function updateTitleColorPie(chart,value) {
                chart.options.title.fontColor = value ;
                chart.render();
            }
            // setting pie chart

            const titles='{{titles|json_encode()|raw}}';

            var arrayTitles = JSON.parse(titles);

            var titles1=""; var titles2=""; var titles3="";
            if(arrayTitles){
                titles1=arrayTitles[0];
                titles2=arrayTitles[1];
                titles3=arrayTitles[2];
            }
            var labels={{axeX|json_encode()|raw}}
            var pie1=[],pieExtra1=[],pieExtra2=[],pieExtra3=[];

            const ar2='{{axeY|json_encode()|raw}}';
            const axe1='{{axe1|json_encode()|raw}}';
            const axe2='{{axe2|json_encode()|raw}}';
            const axe3='{{axe3|json_encode()|raw}}';

            var axey=parseArray(ar2)
            var axeExt1=parseArray(axe1)
            var axeExt2=parseArray(axe2)
            var axeExt3=parseArray(axe3)
            for (var j = 0; j < labels.length; j++) {

                pie1.push({
                    y: axey[j],
                    label: labels[j]
                });
                pieExtra1.push({
                    y: axeExt1[j],
                    label: labels[j]
                });
                pieExtra2.push({
                    y: axeExt2[j],
                    label: labels[j]
                });
                pieExtra3.push({
                    y: axeExt3[j],
                    label: labels[j]
                });

            }
            function hideChart(id,array,rowSetting){
                if(array.length===0){
                    $('#'+id).css('display','none')
                    $('.'+rowSetting).css('display','none')
                }
                else{
                    $('#'+id).css('display','block')
                }
            }
            // hideChart("chartContainer2",axeExt1)
            // hideChart("chartContainer3",axeExt2)
            // hideChart("chartContainer4",axeExt3)
            if(axeExt3.length===0){
                $('#pie3').addClass("offset-3")
            }
            else{
                $('#pie3').removeClass("offset-3")
            }
            showCanvasPie()
            function showCanvasPie(){
                var type='{{ type }}'
                var editType=$('#graphic_edit_type').val()
                console.log('ee')
                console.log(type==="pie" || editType==="pie")
                if(type==="pie" || editType==="pie"){
                    $('#myChart').css('display','none')
                    $('#chartContainer').css('display','block')
                    $('.extraSettings').css('display','block')

                    hideChart("chartContainer2",axeExt1,'showPie2')
                    hideChart("chartContainer3",axeExt2,'showPie3')
                    hideChart("chartContainer4",axeExt3,'showPie4')
                }
            else{
                    $('#myChart').css('display','block')
                    $('#chartContainer').css('display','none')
                    $('#chartContainer2').css('display','none')
                    $('#chartContainer3').css('display','none')
                    $('#chartContainer4').css('display','none')
                    $('#chartContainer').css('display','none')

                }
            }


            var chart1 = new CanvasJS.Chart("chartContainer", {
                theme: "light1", // "light1", "light2", "dark1", "dark2"
                exportEnabled: true,
                animationEnabled: true,
                backgroundColor:"{{ graphBackgroundColor }}",
                title: {
                    text: '{{labelY}}',
                    fontWeight: "bold",
                    borderThickness: 1,
                    padding: 10,
                    margin: 20,
                    fontColor:"{{ graphicTitleColor }}"?"{{ graphicTitleColor }}":"#111"
                },
                data: [{
                    type: "pie",
                    startAngle: 25,
                    toolTipContent: "<b>{label}</b>: {y}%",
                    showInLegend: "true",
                    legendText: "{label}",
                    indexLabelFontSize: 16,
                    indexLabel: "{label}  -  {y}%",
                    dataPoints:pie1
                }]

            });
            chart1.render();
            var chart2 = new CanvasJS.Chart("chartContainer2", {
                theme: "light2", // "light1", "light2", "dark1", "dark2"
                exportEnabled: true,
                animationEnabled: true,
                backgroundColor:"{{ graphBackgroundColor }}",
                title: {
                    text: titles1,
                    fontWeight: "bold",
                    borderThickness: 1,
                    padding: 10,
                    margin: 20,
                    fontColor:"{{ graphicTitleColor }}"?"{{ graphicTitleColor }}":"#111"
                },
                data: [{
                    type: "pie",
                    startAngle: 25,
                    toolTipContent: "<b>{label}</b>: {y}%",
                    showInLegend: "true",
                    legendText: "{label}",
                    indexLabelFontSize: 16,
                    indexLabel: "{label}  -  {y}%",
                    dataPoints: pieExtra1

                }]

            });
