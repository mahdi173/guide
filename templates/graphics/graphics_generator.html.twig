        function getConfigChart(newChartType) {
            var options={
                cutoutPercentage: newChartType==="doughnut" ?50:null,
                layout: {
                    padding: {
                        top: 20
                    }
                },
                responsive: false,
                showDatasetLabels : true,
                legend: {
                    // display: newChartType!=="pie"?false:true,
                    display:true,
                    position: 'bottom',
                    labels: {
                        filter: function(legendItem, chartData) {
                            console.log(legendItem)
                            if (legendItem.text===null ||legendItem.text===undefined ) {
                                return false;
                            }
                            return true;
                        }
                        }

                },
                "hover": {
                    "animationDuration": 0
                },

                "animation": {
                    "duration": 500,
                    "onComplete":

                        function () {
                            if (showValues) {
                                var chartInstance = this.chart, ctx = chartInstance.ctx;
                                ctx.font = Chart.helpers.fontString(14, Chart.defaults.global.defaultFontStyle, Chart.defaults.global.defaultFontFamily);
                                ctx.fillStyle = '#777';
                                ctx.textAlign = 'center';
                                ctx.textBaseline = newChartType==="bar"?'ideographic':'ideographic';
                                if (newChartType !== "pie" && newChartType !== "doughnut" ){

                                    this.data.datasets.forEach(function (dataset, i) {
                                        var meta = chartInstance.controller.getDatasetMeta(i);
                                        meta.data.forEach(function (bar, index) {
                                            var data = dataset.data[index];
                                            ctx.fillText(data, bar._model.x, bar._model.y - 5);
                                            if(newChartType!=="radar"){
                                                ctx.fillStyle = '#454341';
                                            }
                                            else{
                                                ctx.fillStyle = '#555'
                                            }
                                            ctx.fontStyle="bold"

                                        });
                                    });
                                }
                                else {
                                    var dd=this.data.datasets;
                                    var ee=dd.reverse();

                                    ee.forEach(function (dataset) {

                                        for (var i = 0; i < dataset['data'].length; i++) {
                                            var model = dataset._meta[Object.keys(dataset._meta)[0]].data[i]._model,
                                                total = dataset._meta[Object.keys(dataset._meta)[0]].total,
                                                mid_radius = model.innerRadius + (model.outerRadius - model.innerRadius)/2,
                                                start_angle = model.startAngle,
                                                end_angle = model.endAngle,
                                                mid_angle = start_angle + (end_angle - start_angle)/2;


                                            var x = mid_radius * Math.cos(mid_angle);
                                            var y = mid_radius * Math.sin(mid_angle);

                                            // if (i == 3){ // Darker text color for lighter background
                                            //     ctx.fillStyle = '#454341';
                                            //     ctx.fontStyle="bold"
                                            // }
                                            var percent = String(Math.round(dataset.data[i]/total*100)) + "%";
                                            //Don't Display If Legend is hide or value is 0
                                            if(dataset['data'][i] !== 0) {
                                                ctx.fillText(dataset.data[i], model.x + x, model.y + y);
                                                // ctx.fillText(dataset.label, model.x+i*10 , model.y+i*10);

                                                // Display percent in another line, line break doesn't work for fillText
                                                //   ctx.fillText(percent, model.x + x, model.y + y + 15);

                                            }
                                        }
                                        console.log("ee")
                                        console.log(ee)
                                        for (var j = 0; j <ee.length; j++) {
                                            var  mid_radius1 = 110, mid_angle1 = -1.18;
                                            var x1 = mid_radius1 * Math.cos(mid_angle1);
                                            var y1 = mid_radius1 * Math.sin(mid_angle1);
                                            if(ee[j].label !==undefined && ee[j].label){

                                                if(newChartType==="pie"){
                                                    ctx.fillText(ee[j].label, 300+x1+j*-45 , 390+y1+j*-10);
                                                }
                                                else{
                                                    ctx.fillText(ee[j].label, 190+x1+j*-5 , 360+y1+j*35);
                                                }
                                                ctx.fillStyle = '#111';
                                                ctx.fontStyle="bold"
                                            }
                                        }
                                    });

                                }

                            }
                        }

                },
                tooltips: {
                    callbacks: {
                        label: function(item, data) {
                            return data.datasets[item.datasetIndex].label[item.index]
                                + ": " + data.datasets[item.datasetIndex].data[item.index];
                        }
                    }
                },
                scales: {
                    yAxes: [{
                        ticks: {
                            display: newChartType!=="pie"  && newChartType!=="doughnut" && newChartType!=="radar"? true:false,
                            beginAtZero: true,
                            fontSize: 15,
                            fontStyle:"bold"
                        },
                        scaleLabel: {
                            display: newChartType!=="pie"  && newChartType!=="doughnut" && newChartType!=="radar"?true:false,
                            // display: true,
                            labelString: '{{ showTitles }}'? '{{titleY}}':'',
                            fontSize:20,
                            padding:20,
                            fontStyle:"bold"
                        },
                        gridLines:{
                            display: newChartType!=="pie" && newChartType!=="doughnut" && newChartType!=="radar"?true:false,
                            // color:"rgb(32, 35, 11)",
                            borderDash: [3, 5],
                            lineHeight:2,
                             lineWidth:1,
                            color:showGrid==="horizental" || showGrid==="both"?gridColor:null,

                        }
                    }],
                    xAxes: [{
                        ticks: {
                            display: newChartType!=="pie" && newChartType!=="doughnut" && newChartType!=="radar"?true:false,
                            fontSize: 15,
                            fontStyle:"bold"
                        },
                        scaleFontSize: 40,
                        scaleLabel: {
                            display: newChartType!=="pie"  && newChartType!=="doughnut" && newChartType!=="radar"?true:false,
                            // display: true,
                            labelString: '{{ showTitles }}'? '{{titleX}}':'',
                            fontSize:20,
                            padding:20,
                            fontStyle:"bold"
                        },
                        gridLines:{
                            display: newChartType!=="pie" && newChartType!=="doughnut" && newChartType!=="radar"?true:false,
                            //display:false,
                            borderDash: [3, 5],
                            lineWidth:1,
                            lineHeight:2,
                            color:showGrid==="vertical" || showGrid==="both"?gridColor:null,

                        }
                    }]
                },
                title: {
                    fontSize: 29,
                    marginBottom: -20,
                    borderWidth:2,
                    borderColor:"#111",
                    borderStyle:"solid",
                    display: true,
                     text: '{{graphicTitle}}',
                    position: "top",
                    padding:30,
                    {#fontColor:'{{ graphicTitleColor }}'#}
                }
            }
            return options
        }

    </script>
{% endblock %}
