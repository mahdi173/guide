{% extends "base.html.twig" %}

{% block stylesheets %}
    <style>
    #new_data:hover,#removeRow:hover{
        cursor:pointer;
    }
        .createGraph{
            width: 150px !important;
        }
    </style>
{% endblock  %}

{% block content %}

    <div class="row">
        <h4 class="text-center" style="margin-top: 20px;">Graphics generator</h4>
        <p style="margin-top: 30px;margin-bottom: 60px">
            Graphics generator create online graphics, bar, pie or line charts. Just paste your data into the data section of the graph and click the Create Graph button</p>


    </div>


    {{ form_start(form)}}
    <div class="row">
    <div class="col-md-5">

        {{ form_row(form.type)}}<br>
        {{ form_row(form.titleX)}}<br>
        {{ form_row(form.dataX )}}


    </div>

        <div class="col-md-5">

            {{ form_row(form.graphicTitle)}}
            {{ form_row(form.titleY)}}<br>



            {{ form_row(form.color)}}
            {{ form_row(form.showGrid)}}
            {{ form_row(form.showValues)}}


        </div>



    </div>
    <div class="row" style="margin-left: 10px;">
        <div class="col-md-12"><i id="new_data" class="fa fa-plus" aria-hidden="true" style="color: #0b2e13"></i></div>
        <div class="col-md-3 col-sm-12" style="float: left">
            {{ form_row(form.dataY)}}
        </div>
        <div class="col-md-9 col-sm-12" style="float: right">
                <div id="container"></div>
        </div>


    </div>

     <div class="row" style="margin-left: 40px;margin-top: 20px">

        {{ form_row(form.createGraph)}}

    </div>


    {{ form_end(form)}}
    <div class="row" style="display: none;">
        <div class="col-md-12">
            <div class="form-group">
                <label style="display: none;">Nombre de rows</label>
                <input class="form-control max_width_150" name="nombreRows" id="nombreRows" type="hidden" min="0" value="1">
                  <div id="colisSummary" class="margin_top_15" style="display: none;">
            </div>
        </div>
    </div>
    <div id="blockY">
    </div>



{% endblock  %}
{% block javascripts %}
