{% block content %}

    <div class="row">
        <h4 class="text-center" style="margin-top: 20px;">Graphics generator</h4>
        <p style="margin-top: 30px;margin-bottom: 60px">
            Graphics generator create online graphics, bar, pie or line charts. Just paste your data into the data section of the graph and click the Create Graph button</p>
    </div>

    {{ form_start(form)}}
    <div class="settings">
    <h5 class="settings-title">Chart settings</h5>
    <div class="row params">
    <div class="col-md-5">

        {{ form_row(form.type)}}<br>
        {{ form_row(form.titleX)}}<br>
       {{ form_row(form.color)}}

    </div>
        <div class="col-md-5">

