              <div class="col-md-2">

              {{ form_label(form.dataY, null, {  'label_attr': {'class': 'cee'} }) }}
              {{ form_widget(form.dataY)}}
              <i id="new_data" class="fa fa-plus" aria-hidden="true" style="color: #0b2e13"></i>
              </div>

            <div class="col-md-8 col-sm-12" style="float: right">
