        function dealWithToggle(parentSelector){
            if(typeof(parentSelector) == "undefined"){
                parentSelector = "";
            }
            if(parentSelector != ""){
                parentSelector = parentSelector +" ";
            }

            let toggleTarget = parentSelector + '.toggle';
            let toggleSpanTarget = parentSelector + '.toggle span';
            let dataToggleTarget = parentSelector + '[data-toggle]';
            $(toggleTarget).append('<span></span>');
            $(toggleSpanTarget).click(function() {
                $(this).parent().find('input').prop('checked', !$(this).parent().find('input').prop('checked'))
                $(this).parent().find('input').trigger('change')
            })
            $(toggleSpanTarget).click(function() {
                $(this).parent().find('textarea').prop('checked', !$(this).parent().find('textarea').prop('checked'))
                $(this).parent().find('textarea').trigger('change')
            })

            $(dataToggleTarget).change(function() {

                if($(this).prop('checked')) $($(this).attr('data-toggle')).slideDown()
                else $($(this).attr('data-toggle')).slideUp()
            })

            $(dataToggleTarget).each(function() {

                if($(this).prop('checked')) $($(this).attr('data-toggle')).show()
                else $($(this).attr('data-toggle')).hide()
            })
        }

        function dealWithColisInput(index, target){

            var textarea = target.find("textarea");
            var text = target.find("input");
            var label = target.find("label");

            label.each(function () {
                var name = $(this).attr('class');
                var newName = name + index;
                $(this).attr('class',newName);
                $(this).attr('data-number',index);
            });
            text.each(function () {
                var name = $(this).attr('class');
                var newName = name + index;
                $(this).attr('class',newName);
                $(this).attr('data-number',index);
            });

            textarea.each(function () {
                var name = $(this).attr('class');
                var newName = name + index;
                $(this).attr('class',newName);
                $(this).attr('data-number',index);
            });

            var deleteTarget = target.find(".delete_colis_row");
            deleteTarget.attr('data-number',index)

            if(!target.hasClass("dealtWith")){
                target.addClass("dealtWith");
                target.attr("data-number",index);
                target.attr("id","row"+index);
            }

            return "#ligne"+index;
        }
