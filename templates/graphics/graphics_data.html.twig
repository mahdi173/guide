                    $("#graphic_data_titleY").val(arrayData.titleY);
                    $("#graphic_data_graphicTitle").val(arrayData.graphicTitle)
                    $("#graphic_data_color").val(arrayData.color);

                    var text1=document.getElementById("graphic_data_dataX");
                    text1.value=textareaX.join('\n');

                    var text2=document.getElementById("graphic_data_dataY");
                    text2.value=textareaY.join('\n');


                    if(arrayData.showValues !== ""){
                        $("#graphic_data_showValues").prop( "checked",true );
