{% extends 'community/base.html.twig' %}

{% block security %}
    <style>
        .form-signin {
            width: 100%;
            max-width: 330px;
            padding: 15px;
            margin: 0 auto;
        }
    </style>
    <h1 class="text-center">{{ 'Registration'|trans }}</h1>

    {% if app.request.get('send') == 'true' %}
        <p>
            {{ 'registration_finished'|trans }}
        </p>
    {% else %}
        <div class="row">

        </div>
{#       {{ form(form, { 'attr': {'class': 'form-signin'} }) }}#}
        {{ form_start(form, { 'attr': {'class': 'form-signin'} }) }}

{#        <div class="alert alert-danger" role="alert">#}
{#            #}
{#        </div>#}

        <div class="form-label-group ">
            <label for="registration_username">firstName:</label>
            {{ form_widget(form.firstName, { 'attr': {'class': 'form-control form-control-lg  mr-lg-2'} }) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_lastName">lastName:</label>
            {{ form_widget(form.lastName, { 'attr': {'class': 'form-control form-control-lg  mr-lg-2'} }) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_username">Username:</label>
            {{ form_widget(form.username, { 'attr': {'class': 'form-control form-control-lg  mr-lg-2'} }) }}
            {{ form_errors(form.username) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_email">email:</label>
            {{ form_widget(form.email, { 'attr': {'class': 'form-control form-control-lg  mr-lg-2'} }) }}
            {{ form_errors(form.email) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_plainPassword">Password:</label>
            {{ form_widget(form.plainPassword, { 'attr': {'class': 'form-control form-control-lg  mr-lg-2'} }) }}
        </div>
{#        <div class="form-label-group">#}
{#            <label for="registration_plainPassword">Confirm Password:</label>#}
{#            {{ form_widget(form.plainPassword, { 'attr': {'class': 'form-control form-control-lg  mr-lg-2'} }) }}#}
{#        </div>#}
        <div class="checkbox mb-3">

            <label class="mr-lg-2 mt-4">
                {{ form_widget(form.terms) }} Terms
            </label>
        </div>
        <button type="submit" id="registration_submit" name="registration[submit]" class="btn btn-lg btn-info mr-2 mr-lg-2">Register</button>

        {{ form_end(form, {'render_rest': false}) }}

