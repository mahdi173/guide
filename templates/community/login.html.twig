{% extends 'community/base.html.twig' %}
 {% block security %}
    {% if error %}
        <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

     <style>
         .form-signin {
             width: 100%;
             max-width: 330px;
             padding: 15px;
             margin: 0 auto;
         }
     </style>

{#     <a href="#" class="pop-close" data-dismiss="modal"><img src={{ asset('/assets/images/logo1.png') }} alt="" /></a>#}
     <h4 class="text-center">Login</h4>
    <form action="{{ path('sulu_community.login') }}" method="post" class="form-signin">
        <div class="tab">

            <div class="input-field s12">
                <label for="username">Username:</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" class="form-control form-control-lg  mr-lg-2" />
            </div>

            <div class="input-field s12">
                <label for="password">Password:</label>
                <input type="password" id="password" name="_password" class="form-control form-control-lg  mr-lg-2" />
            </div>

            <div class="checkbox mb-3">

                <label class="mr-lg-2">
                    <input type="checkbox" id="remember_me" name="_remember_me" checked />
                    Keep me logged in
                </label>
            </div>

            {#
                If you want to control the URL the user
                <input type="hidden" name="_target_path" value="/account" />
            #}

            <button type="submit" class="btn btn-lg btn-info mr-2 mr-lg-2 mb-3" name="submit">login</button>
        </div>

        <a class="mt-5 mb-3 text-muted" href="{{ path('sulu_community.password_forget') }}">
            Password Forget
        </a> <br/>

        <a class="mt-5 mb-3 text-muted" href="{{ path('sulu_community.registration') }}">
            Registration
        </a>

    </form>

 {% endblock security %}
