{% extends 'member.html.twig' %}

{% block title %}Tag{% endblock %}

{% block member_content %}
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>Tag Detail :</h1>
                <table class="table">
                    <tbody>
                        <tr>
                            <th>Id</th>
                            <td>{{ tag.id }}</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>{{ tag.name }}</td>
                        </tr>
                        <tr>
                            <th>Description</th>
                            <td>{{ tag.description }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-9">
                <a href="{{ path('tag_index') }}">back to list</a>
                <a href="{{ path('tag_edit', {'id': tag.id}) }}">edit</a>
            </div>
            <div class="col-3">
                {{ include('tag/_delete_form.html.twig') }}
            </div>
        </div>
    </div>

{% endblock %}
