{% extends 'base.html.twig' %}

{% block body %}
    <h1>Data_reuter</h1>

    <table>
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ data_reuter.id }}</td>
            </tr>
            <tr>
                <th>Rank</th>
                <td>{{ data_reuter.rank }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ data_reuter.title }}</td>
            </tr>
            <tr>
                <th>Totalcites</th>
                <td>{{ data_reuter.totalCites }}</td>
            </tr>
            <tr>
                <th>Journalimpactfactor</th>
                <td>{{ data_reuter.journalImpactFactor }}</td>
            </tr>
            <tr>
                <th>Eigenfactorscore</th>
                <td>{{ data_reuter.eigenfactorScore }}</td>
            </tr>
            <tr>
                <th>Issn</th>
                <td>{{ data_reuter.iSSN }}</td>
            </tr>
            <tr>
                <th>Eissn</th>
                <td>{{ data_reuter.eISSN }}</td>
            </tr>
            <tr>
                <th>Categoryname</th>
                <td>{{ data_reuter.categoryname }}</td>
            </tr>
        </tbody>
    </table>

    <ul>
        <li>
            <a href="{{ path('data_reuters_index') }}">Back to the list</a>
        </li>
        <li>
            <a href="{{ path('data_reuters_edit', { 'id': data_reuter.id }) }}">Edit</a>
        </li>
        <li>
            {{ form_start(delete_form) }}
                <input type="submit" value="Delete">
            {{ form_end(delete_form) }}
        </li>
    </ul>
{% endblock %}
