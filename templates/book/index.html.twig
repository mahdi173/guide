{% extends 'member.html.twig' %}

{% block title %}GuideJournal: Books{% endblock %}

{% block member_content %}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>Book index</h1>

            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Title</th>
                        <th>Publisher</th>
                        <th>Url</th>
                        <th>Authors</th>
                        <th>Year</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for book in books %}
                    <tr>
                        <td>{{ book.id }}</td>
                        <td>{{ book.title }}</td>
                        <td>{{ book.publisher }}</td>
                        <td>{{ book.url }}</td>
                        <td>{{ book.authors }}</td>
                        <td>{{ book.year }}</td>
                        <td>
                            <a href="{{ path('book_show', {'id': book.id}) }}">show</a>
                            <a href="{{ path('book_edit', {'id': book.id}) }}">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <a href="{{ path('book_new') }}">Create new</a>
        </div>
    </div>
</div>

{% endblock %}
