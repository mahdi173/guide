{% extends '@SuluCommunity/profile-form.html.twig' %}

{% block title %}GuideJournal: Books{% endblock %}

{% block profile_content %}


            <h1>Book index</h1>

            <table class="table">
                <thead>
                    <tr class="table-active">
                        <th colspan="8">Title</th>
{#                        <th>Publisher</th>#}
{#                        <th>Url</th>#}
{#                        <th>Authors</th>#}
                        <th>Year</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for book in books %}
                    <tr>
                        <td colspan="8" class="w-70 border-0">
                            <p class="font-weight-bold text-primary"> {{ book.title }}</p>
                            <p class="font-weight-light text-muted mt-n3"><small> Author : {{ book.authors }}</small></p>
                            <p class="font-weight-light text-muted mt-n3"><small> Publisher : {{ book.publisher }}</small></p>
                        </td>
{#                        <td>{{ book.publisher }}</td>#}
{#                        <td>{{ book.url }}</td>#}
{#                        <td>{{ book.authors }}</td>#}
                        <td class="border-0">{{ book.year }}</td>
                        <td class="border-0">
                            <a href="{{ path('book_show', {'id': book.id}) }}">show</a>
                            <a href="{{ path('book_edit', {'id': book.id}) }}">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <a href="{{ path('book_new') }}">Create new</a>


{% endblock %}
