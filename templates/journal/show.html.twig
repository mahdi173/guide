                </div>
                <div class="col-md-10 text j-table">
                    <h6 >GENERAL INFORMATION</h6>
                    <table class="table">
                        <tbody>
                        <tr class="col-title">
                            <td >SJR</td>
                            <td>{{ journal.sjr|default('') }}</td>
                        </tr>
                        <tr class="col-title">
                            <td >Rank</td>
