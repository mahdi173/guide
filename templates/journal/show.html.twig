                            <td>{{ journal.publisherOrg.name|default('') }}</td>
                        </tr>
                        <tr class="col-title">
                            <td>Open Access</td>
                            <td> {{ journal.isOpenAccess ? 'YES' : 'NO' }}</td>
                        </tr>
                        <tr class="col-title">
                            <td>Quartile</td>
                            <td>{{ journal.quartile|default('') }}</td>
                        </tr>
                        <tr class="col-title">
                            <td> Citation Count</td>
                            <td> {{ journal.citationCount }}</td>
                        </tr>
                        <tr class="col-title">
                            <td>  P-ISSN</td>
                            <td> {% if journal.originalPrintISSN %}{{ journal.printISSN }}{% endif %}</td>
                        </tr>
                        <tr class="col-title">
                            <td> E-ISSN</td>
                            <td>{% if journal.originalEISSN %}{{ journal.eissn }}{% endif %}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <div class="row btns-share">
