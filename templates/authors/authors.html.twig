{% extends "base.html.twig" %}
{% block title %}Authors | {{ parent() }}{% endblock %}
{% block meta %}
    {% include "SuluWebsiteBundle:Extension:seo.html.twig" with {
        "seo": extension.seo|default([]),
        "content": content|default([]),
        "urls": urls|default([]),
        "shadowBaseLocale": shadowBaseLocale|default(),
        "defaultLocale": request.defaultLocale|default('de')
    } %}
{% endblock %}

{% block stylesheets %}


<style>
    .stat_info{
        padding-left: 3px;
        font-size: 14px;
        color: #555;
    }
    .borderless td, .borderless th {
        border: none;
    }

</style>
{% endblock %}
{% block body %}


    <div class="row  {% if data.result.hits.hit is not defined %}cart-form{% else%}cart-with-res{% endif%} row-form" >
        <div class="col-md-2 col-sm-1"></div>
        <div class="col-md-8 mt-5 mb-5">
            <h1 class="text-primary text-center mb-5" style="font-size: 2.3rem;"><b>Find Authors </b></h1>

            <h6 class="text-authors text-justify font-italic text-secondary" style="font-size: 1rem;line-height: 1.5rem;">Search more than 10 million from all countries, and follow, share, and discuss their researches. We're guided by our mission to help and connect authors and make research open to all.</h6><br>

            <form method="get" action="{{ url('get_authors') }}">

                <div class="input-group mb-3  input-search">
                    <span class="icon-search" >
                        <i class="fa fa-search"></i>
                     </span>
                    <input type="text" id="searchValue" name="authorValue"  class="form-control searchValue" placeholder="Author name" aria-label="Title, word, ISSN" aria-describedby="texte-bouton">
{#                    <div class="input-group-append">#}
{#                        <button class="btn btn-outline-info" type="submit" id="texte-bouton"><i class="fa fa-search"></i> Search</button>#}
{#                    </div>#}
                </div>
            </form>
        </div>
        <div class="col-md-2 col-sm-1"></div>
    </div>

    <div class="row">
        <div class="col-md-2 col-sm-12"></div>
        <div class="col-md-8 mt-5 mb-5">
            {% if data.result.hits.hit is defined %}

                <table id="auteurs"  class="table table-hover table-publication borderless" data-toggle="table" data-striped="true" style="border: 1px #DCDCDC solid">
                    <thead class="table-light">
                         <tr  class="table-light">
                             <th>Title</th>
                             <th></th>
                             <th></th>
                         </tr>
                    </thead>
                    <tbody>

                    {% for res in data.result.hits.hit  %}
                            <tr>
                            <td style="padding: 20px" width="20%">
                                <img class="rounded-circle img-authors" src="{{ asset('assets/images/profil_new.jpg') }}" alt="{{ res.info.author }}"/>
                            </td>


                          <td style="padding: 40px 20px" width="60%">
                                <p class="font-weight-bold saveProfile"  data-author="{{ res.info.author }}"><a class="savePro" href="{{ path('get_authors_publication', {auteur: res.info.author}) }}">{{ res.info.author }}</a><br>
                        {% for keyAuthor,valueAuthor in total %}
                            {% if keyAuthor == res.info.author|replace({'+': " ", '*': "", '.': "",'-': " "}) %}
                                    <span class="stat_info">
                                          {{ valueAuthor }} publications
                                    </span>
                            {% endif %}
                        {% endfor %}
                                    <span class="stat_info"> 0  posts</span>
                                    <span class="stat_info"> {{ countFollowers }}  followers</span>
                                    <span class="stat_info">   {% if author_db %}{{author_db.follows|length  }}
                                        {% else %} 0 {% endif %} following</span></p>
                            </td>

                         {% if app.user is not null %}

                            {% set  follows=app.user.follows.values%}
                            {% set  countF=0%}

                            {% for follow in follows %}
                                {% if follow.following == res.info.author %}
                                    {% set countF=countF+1%}
                                {% endif %}
                            {% endfor %}
                            <td style="padding: 40px 20px" width="20%">
                                <a href="{{ path('add_follower', {'author': res.info.author,'exist':exist|length,'redirect':app.request.attributes.get('_route'),'firstname':app.user.firstName,'lastname':app.user.lastName,'id':app.user.id}) }}" class="btn btn-primary follow" data-author="{{ res.info.author }}" >{% if countF>0 %} UnFollow{% else %}Follow{% endif %}</a>

                            </td>
                         {% else %}
                             <td style="padding: 40px 20px" width="20%">
                                 <a href="{{ path('add_follower', {'author': res.info.author,'exist':exist|length,'redirect':app.request.attributes.get('_route'),'firstname':" ",'lastname':" ",'id':0}) }}" class="btn btn-primary follow " data-author="{{ res.info.author }}" >Follow</a>

                             </td>
                         {% endif %}
                        </tr>


                  {% endfor %}

                    </tbody>
                </table>
            {% elseif parametre==true  %}
                <p class="text-center border pt-3 pb-3">
                    No data found !
                </p>
            {% elseif parametre==false  %}

                    <p> </p>
            {% endif %}
        </div>
        <div class="col-md-2 col-sm-12"></div>
    </div>

    {% block javascripts %}
        <script type="text/javascript">

            // $(document).ready(function() {
            //     $('#auteurs').dataTable();
            // } );
            $('.icon-search').on("click", function () {
                $('#searchValue').focus();
            })
        </script>
    {% endblock %}


{% endblock %}
