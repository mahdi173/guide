{% extends "base.html.twig" %}

{% block meta %}
    {% include "SuluWebsiteBundle:Extension:seo.html.twig" with {
        "seo": extension.seo|default([]),
        "content": content|default([]),
        "urls": urls|default([]),
        "shadowBaseLocale": shadowBaseLocale|default(),
        "defaultLocale": request.defaultLocale|default('de')
    } %}
{% endblock %}

{% block content %}

    <div class="row  mb-3">
        <div class="col-md-2 col-sm-1"></div>
        <div class="col-md-8 mt-5 mb-5">
            <form method="get" action="{{ url('get_authors') }}">

                <div class="input-group mb-3">
                    <input type="text" name="authorValue"  class="form-control" placeholder="Author name" aria-label="Title, word, ISSN" aria-describedby="texte-bouton">
                    <div class="input-group-append">
                        <button class="btn btn-outline-info" type="submit" id="texte-bouton"><i class="fa fa-search"></i> Search</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-2 col-sm-1"></div>
    </div>

    <div class="row ">

        <div class="col-md-1  mb-2" style="margin-top: -10px">  <img class="rounded-circle" src="{{ asset('assets/images/profil_new.jpg') }}" width="130" height="130" /></div>
        <div class="col-md-6  mb-2" style="margin-left: 70px;padding-top: 20px;">
            <h5 class="text-primary">{{ auteur }}</h5>
           <span class="stat_info">   {{  data_dblp| length +  data_doaj.results| length}} publications</span><span class="stat_info"> 0  posts</span><span class="stat_info"> {{ countFollowers }}  followers</span><span class="stat_info"> 0  following</span></p>
        </div>

        <div class="offset-2 col-md-2  mb-2" style="padding-left: 70px;padding-top: 20px;">
            {% set  follows=app.user.follows.values%}

            {% set  count=0%}

            {% for follow in follows %}
                {% if follow.following == auteur %}
                    {% set count=count+1%}
                {% endif %}
            {% endfor %}
            <a href="{{ path('add_follower', {'author': auteur,'exist':exist|length,'redirect':app.request.attributes.get('_route'),'firstname':app.user.firstName,'lastname':app.user.lastName}) }}" class="btn btn-primary follow follow-btn" data-author="{{ auteur }}" >{% if count>0 %} UnFollow{% else %}Follow{% endif %}</a>
        </div>
    </div>

<div class="row" style="margin-top: 30px">
    <div class="col-md-12 mt-3 mb-5">

        <table class="table table-hover table-bordered table-publication" data-toggle="table" data-striped="true">
            <thead class="table-light">
            <tr  class="table-light">

                <th colspan="8">Title</th>
                <th>Year</th>
            </tr>
            </thead>
            <tbody>
            {% if data_doaj| length >0 %}
                {% for result in data_doaj.results %}
                    <tr>
                        <td colspan="8" class="w-70 border-0 mb-n5">
                            <p class="font-weight-bold text-primary">
                                {% for l in result.bibjson.link %}

{#                                    {% for s in result.bibjson.journal.issns %}#}
{#                                        {% for ds in dataissn.printissn %}#}
{#                                        {% if (ds == s|replace({'-':''})) %}#}
{#                                            {{ dump(ds) }}#}
{#                                        {% endif %}#}
{#                                            {% endfor %}#}
{#                                    {% endfor %}#}

                                    {% if l is defined %} <a href="{{ l.url }}" target="_blank"> {{ result.bibjson.title }} </a>{% endif %}

                                   {% if l is defined %} <a href="{{ l.url }}" target="_blank"> {{ result.bibjson.title }} </a>{% endif %}
                                {% endfor %}
                            </p>
                            <p class="font-weight-light text-muted mt-n3">
                                <small>Authors :
                                    {% for a in result.bibjson.author[:30] %}
                                        <a href="{{ path('get_authors_publication', {auteur: a.name}) }}"> {{ a.name }} </a>
                                        {% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </small></p>
                            <p class="font-weight-light text-muted mt-n4 mb-n3">
                                <small>
                                    {% if result.bibjson.identifier| length >0 %}
                                    {% for d in dataissn %}

                                        {% for iss in result.bibjson.journal.issns %}
                                            {#                                            {{ dump(iss) }}#}

                                            {% if(d.issn|replace({'-':''}) == iss|replace({'-':''})) %}
                                                <a href="{{ path('data_t_scopus_results', {'eISSN': d.issn })}}"> {{ result.bibjson.journal.title }}</a>

                                            {% endif %}
                                        {% endfor %}
                                        {% else %}
                                            {{ result.bibjson.journal.title }}
                                    {% endfor %}

                                    {% endif %},
                                    {% if result.bibjson.journal.number is defined %}{{ result.bibjson.journal.number }}{% endif %}
                                    {% if result.bibjson.journal.volume is defined %}({{ result.bibjson.journal.volume }}){% endif %},
                                    Pages :{% if result.bibjson.start_page is defined %}{{ result.bibjson.start_page }}{% endif %}{% if result.bibjson.end_page is defined %}-{{ result.bibjson.end_page }}{% endif %}
                                    {% for d in dataissn %}

                                        {% for iss in result.bibjson.journal.issns %}
{#                                            {{ dump(iss) }}#}

                                            {% if(d.issn|replace({'-':''}) == iss|replace({'-':''})) %}
                                                <a href="{{ path('data_t_scopus_results', {'eISSN': d.issn })}}"><span class="badge badge-primary">Verified by </span> <img src="{{ asset('assets/images/logo1.png') }}"  class="rounded" title="Guidejournal" alt="Guidejournal" height="20" width="20"></a>

                                            {% endif %}
                                        {% endfor %}
                                    {% endfor %}
                                </small>
                            </p>
                        </td>
                        <td class="border-0">
                            {% if result.bibjson.year is defined %}
                            {{ result.bibjson.year }}

                            {% endif%}
                        </td>
                    </tr>
                {% endfor %}

            {% endif %}
            {% if data_dblp| length >0 %}
                {% for res in data_dblp  %}
                    <tr>
                        <td colspan="8" class="w-70 border-0 mb-n5">
                            <p class="font-weight-bold text-primary"><a href="{{ res.info.url }}" target="_blank"> {{ res.info.title }} </a></p>
                            <p class="font-weight-light text-muted mt-n3">
                                <small>Authors :
                                    {% for a in res.info.authors.author %}
                                        <a href="{{ path('get_authors_publication', {auteur: a.text}) }}"> {{ a.text }} </a>
                                        {% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </small></p>
                            <p class="font-weight-light text-muted mt-n4 mb-n3">
                                <small>
                                    {% if res.info.venue is defined %}
                                        {% for v in res.info.venue %}
                                            {{ v }}
                                        {% endfor %}
                                    {% endif %},
                                    {% if res.info.number is defined %}{{ res.info.number }}{% endif %}
                                    {% if res.info.volume is defined %}({{ res.info.volume }}),
                                        {% if res.info.pages is defined %}Pages :{{ res.info.pages }}{% endif %}{% endif %}
                                </small>
                            </p>
                        </td>
                        <td class="border-0">{{ res.info.year }}</td>
                    </tr>
                {% endfor %}
{#            {% else %}#}
{#                    <tr>#}
{#                        <td colspan="9">no results fzound</td>#}
{#                    </tr>#}
            {% endif %}
            {% if data_doaj| length ==0 and data_doaj| length%}
            <tr>
                <td colspan="9">no results found</td>
           </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
</div>



{% endblock %}
