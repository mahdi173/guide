{% extends '@SuluCommunity/profile-form.html.twig' %}

{#{% block title %}GuideJournal: Chapters{% endblock %}#}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/8.11.8/sweetalert2.min.css">
    <style>
    .stat{
        padding-left: 10px;
    }
        .swal2-header{
            padding-top: 30px;
        }
    .swal2-title{
        font-size: 23px!important;
    }
    .swal2-actions{
            padding-bottom: 30px;
        }
    </style>
{% endblock  %}
{% block profile_content %}


    <h5 class="text-primary">Save your profile ?</h5><hr>
    {% for i in 0..2 %}
    <div class="row">
        <div class="col-md-2">
            <img class="rounded-circle" src="{{ asset('assets/images/avatar.png') }}" width="50" height="50"/>
        </div>
        <div class="col-md-7" style="color:#555;">  <a href="#">Lorem ipsum dolor sit amet</a><br>20 publications <span class="stat"> 0 posts  </span> <span class="stat">17 followers</span><span class="stat"> 3 following</span></div>
        <div class="col-lg-3"><button class="btn btn-primary saveButton">Save</button></div>
    </div><hr>
    {% endfor %}
<div class="row">
    <div class="offset-9 col-lg-3" style="margin-top: 40px"><button class="btn btn-warning">No Thanks</button></div>
</div>

{% endblock %}

{% block javascripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/8.11.8/sweetalert2.all.min.js"></script>

    <script>
        $(document).on("click",".saveButton",function(){
            Swal.fire({
                title: 'Is this profile really for you ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes!'
            }).then((result) => {
                if (result.value) {
                    Swal.fire(
                        'Deleted!',
                        'Your file has been deleted.',
                        'success'
                    )
                }
            })

        })
    </script>
{% endblock %}


