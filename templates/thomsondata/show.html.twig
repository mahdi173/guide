{% extends 'base.html.twig' %}

{% block body %}
    <h1>Thomsondatum</h1>

    <table>
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ thomsonDatum.id }}</td>
            </tr>
            <tr>
                <th>Rank</th>
                <td>{{ thomsonDatum.rank }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ thomsonDatum.title }}</td>
            </tr>
            <tr>
                <th>Totalcites</th>
                <td>{{ thomsonDatum.totalCites }}</td>
            </tr>
            <tr>
                <th>Journalimpactfactor</th>
                <td>{{ thomsonDatum.journalImpactFactor }}</td>
            </tr>
            <tr>
                <th>Eigenfactorscore</th>
                <td>{{ thomsonDatum.eigenfactorScore }}</td>
            </tr>
            <tr>
                <th>Issn</th>
                <td>{{ thomsonDatum.iSSN }}</td>
            </tr>
            <tr>
                <th>Eissn</th>
                <td>{{ thomsonDatum.eISSN }}</td>
            </tr>
            <tr>
                <th>Categoryname</th>
                <td>{{ thomsonDatum.categoryname }}</td>
            </tr>
        </tbody>
    </table>

    <ul>
        <li>
            <a href="{{ path('thomsondata_index') }}">Back to the list</a>
        </li>
        <li>
            <a href="{{ path('thomsondata_edit', { 'id': thomsonDatum.id }) }}">Edit</a>
        </li>
        <li>
            {{ form_start(delete_form) }}
                <input type="submit" value="Delete">
            {{ form_end(delete_form) }}
        </li>
    </ul>
{% endblock %}
