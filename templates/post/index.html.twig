{% extends 'member.html.twig' %}

{% block title %}GuideJournal: Articles List{% endblock %}

{% block member_content %}

    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1>Posts :</h1>
                <table class="table table-striped tabResult">
                    <thead class="thead-light">
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Title</th>
                        <th scope="col">Content</th>
                        <th scope="col">Image</th>
                        <th scope="col">Created At</th>
                        <th scope="col">Published At</th>
                        <th scope="col">actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for post in posts %}
                        <tr>
                            <td>{{ post.id }}</td>
                            <td>{{ post.title }}</td>
                            <td>{{ post.content[:50] ~ '...' }}</td>
                            <td>{{ post.imageUrl }}</td>
                            <td>{{ post.createdAt ? post.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                            <td>{{ post.publishedAt ? post.publishedAt|date('Y-m-d H:i:s') : '' }}</td>
                            <td>
                                <a style="display: inline-block;" href="{{ path('post_show', {'id': post.id}) }}">show</a>
                                <a style="display: inline-block;" href="{{ path('post_edit', {'id': post.id}) }}">edit</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">no records found</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <a href="{{ path('post_new') }}">Create new</a>
            </div>
        </div>
    </div>


{% endblock %}
