{% extends '@SuluCommunity/profile-form.html.twig' %}

{% block title %}GuideJournal: Conferences{% endblock %}

{% block profile_content %}


            <h1>Conference index</h1>

            <table class="table">
                <thead>
                    <tr class="table-active">
                        <th colspan="8">Title</th>
{#                        <th>ConferenceName</th>#}
{#                        <th>Url</th>#}
{#                        <th>ConferenceDate</th>#}
{#                        <th>Adresse</th>#}
{#                        <th>Authors</th>#}
                        <th>Year</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for conference in conferences %}
                    <tr>
                        <td colspan="8" class="w-70 border-0">
                            <p class="font-weight-bold text-primary">{{ conference.title }}</p>
                            <p class="font-weight-light text-muted mt-n3"><small> Author : {{ conference.authors }}</small></p>
                            <p class="font-weight-light text-muted mt-n3"><small> Conference Name : {{ conference.authors }}, {{ conference.conferenceDate ? conference.conferenceDate|date('Y-m-d H:i:s') : '' }}, {{ conference.adresse }}</small></p>
                        </td>
{#                        <td>{{ conference.conferenceName }}</td>#}
{#                        <td>{{ conference.url }}</td>#}
{#                        <td>{{ conference.conferenceDate ? conference.conferenceDate|date('Y-m-d H:i:s') : '' }}</td>#}
{#                        <td>{{ conference.adresse }}</td>#}
{#                        <td>{{ conference.authors }}</td> #}
                        <td>{{ conference.year }}</td>
                        <td>
                            <a href="{{ path('conference_show', {'id': conference.id}) }}">show</a>
                            <a href="{{ path('conference_edit', {'id': conference.id}) }}">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <a href="{{ path('conference_new') }}">Create new</a>


{% endblock %}
