{% extends 'base.html.twig' %}

{% block body %}
    <style>
        .IN-widget{
            position: relative;
            bottom: 2px;
        }
        .IN-widget button{
            height: 21px !important;
        }
        .fb-share-button{
            height: 21px;
            width: 55px;
            display: inline-block;
            margin: 5px;
        }
        .btn{
            position: relative;
            top: 1px;
            box-sizing: border-box;
            padding: 0 8px 0 6px;
            background-color: #0c7abf;
            color: #fff;
            cursor: pointer;
            display: inline-block;
            margin-left: 10px;
            font-size: 13px;
        }
        .btn:hover{
            color: #fff;
            opacity: 0.9;
        }
        .btn i {
            position: relative;
            top: 2px;
            display: inline-block;
            width: 14px;
            height: 14px;
            background: transparent 0 0 no-repeat;
            background-image: none;
            background-image: url(data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2072%2072%22%3E%3Cpath%20fill%3D%22none%22%20d%3D%22M0%200h72v72H0z%22%2F%3E%3Cpath%20class%3D%22icon%22%20fill%3D%22%23fff%22%20d%3D%22M68.812%2015.14c-2.348%201.04-4.87%201.744-7.52%202.06%202.704-1.62%204.78-4.186%205.757-7.243-2.53%201.5-5.33%202.592-8.314%203.176C56.35%2010.59%2052.948%209%2049.182%209c-7.23%200-13.092%205.86-13.092%2013.093%200%201.026.118%202.02.338%202.98C25.543%2024.527%2015.9%2019.318%209.44%2011.396c-1.125%201.936-1.77%204.184-1.77%206.58%200%204.543%202.312%208.552%205.824%2010.9-2.146-.07-4.165-.658-5.93-1.64-.002.056-.002.11-.002.163%200%206.345%204.513%2011.638%2010.504%2012.84-1.1.298-2.256.457-3.45.457-.845%200-1.666-.078-2.464-.23%201.667%205.2%206.5%208.985%2012.23%209.09-4.482%203.51-10.13%205.605-16.26%205.605-1.055%200-2.096-.06-3.122-.184%205.794%203.717%2012.676%205.882%2020.067%205.882%2024.083%200%2037.25-19.95%2037.25-37.25%200-.565-.013-1.133-.038-1.693%202.558-1.847%204.778-4.15%206.532-6.774z%22%2F%3E%3C%2Fsvg%3E);
        }
    </style>
    <!-- Load Facebook SDK for JavaScript -->
    <div id="fb-root"></div>
    <script>
        (function(d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v3.0";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
    </script>

    {% set test=-1 %}
    {% set compteur=0 %}
    {% set compteur1=0 %}
    {% set tests=-1 %}

    {% set issn="" %}
    <div class="container-fluid">

        <!-- Pubi 0001-->

        <!-- /21831250958/guidejournal_home_pub0001 -->
        <div id='div-gpt-ad-1563781924570-0' style="align-content: center">
            <script>
                googletag.cmd.push(function() { googletag.display('div-gpt-ad-1563781924570-0'); });
            </script>
        </div>

        <!-- Fin pub 0001-->
        <div class="row" style="background-image:url({{ asset('assets/images/dsk.jpg') }}); height: 400px;
                background-repeat:no-repeat; background-size:cover  ">
            <div class="col-sm-12"> </div>
            <div class="col-lg-2 col-sm-1"></div>
            <div class="col-lg-8" style="margin-top: 40px">

                <div class="row col-lg-12 "> <h2 class="text-info">Find the best journal for your research</h2></div>
                {{ form_start(form) }}
                <div class="row">
                    <div class="col-lg-8">
                        {{ form_widget(form.searchValue,{ 'attr': {
                            'placeholder': 'Title, word, ISSN' }}) }}
                    </div>
                    <div class="col-lg-4">
                        {{ form_widget(form.submit,{ 'attr': {
                            'class': 'btn btn-info' }}) }}
                    </div>
                    {{ form_end(form) }}

                    <!-- publicité adSense 1-->
                    <div style="margin-top: 20px;">


                        <!-- horizontal_apres_zone_recherche -->
                        <ins class="adsbygoogle"
                             style="display:inline-block;width:728px;height:90px"
                             data-ad-client="ca-pub-9897811061542650"
                             data-ad-slot="5854996173"></ins>
                        <script>
                            (adsbygoogle = window.adsbygoogle || []).push({});
                        </script>
                    </div>

                </div>


                <!-- fin publicité adSense 1-->
            </div>
            <div class="col-lg-2 col-sm-1"></div>
        </div>

        <div class="row" >
            <div class="col-sm-2">

                <!-- ajouter pour la publicité -->
                <!-- Publicité  -->
                <div class="row" style="margin-bottom: 2px" name="pub3" id="pub3">
                    <!--  <h1 align="center">Bonjour ici mettre votre publicité 3 </h1>-->

                    <!-- /21831250958/guidejournal_home_droit_pub3 -->
                    <div id='div-gpt-ad-1563190598897-0'>
                        <script>
                            googletag.cmd.push(function() { googletag.display('div-gpt-ad-1563190598897-0'); });
                        </script>
                    </div>

                </div>
                <!-- Publicité  -->

                <!-- fin publicité -->
            </div>
            <div class="col-sm-8" name="pub1" id="pub1">
                <!-- Publicité  -->
                <div class="row col-sm-12" style="height: 50px"></div>
                <div class="row">

                    <div class="col-sm-12" >
                        <!--   <h1 align="center">Bonjour ici mettre votre publicité 1 </h1>-->
                        <!-- /21831250958/guidejournal_home_pub1 -->
                        <div id='div-gpt-ad-1563189608012-0'>
                            <script>
                                googletag.cmd.push(function() { googletag.display('div-gpt-ad-1563189608012-0'); });
                            </script>
                        </div>
                    </div>

                </div>
                <!-- Publicité  -->
            </div>
            <div class="col-sm-2">
                <!-- Publicité  -->
                <div class="row" style=" margin-bottom: 2px" name="pub44" id="pub44">
                    <!--  <h1 align="center">Bonjour ici mettre votre publicité 4 </h1> -->

                    <!-- /21831250958/guidejournal_Home_gauche_Pub44 -->
                    <div id='div-gpt-ad-1563190410863-0'>
                        <script>
                            googletag.cmd.push(function() { googletag.display('div-gpt-ad-1563190410863-0'); });
                        </script>
                    </div>
                </div>
                <!-- Publicité  -->

            </div>
        </div>
        {%  if data_t_scopus | length >1 %}
        {% set test=0 %}
        {% set tests=0 %}
        <div class="row">
            <div class="col-lg-2">
            </div>
            <div class="col-lg-8">
                <div class="row" style="height: 50px">
                    <div class="col-lg-12">
                        <h3 align="center">The following title(s) matched your request</h3>
                    </div>
                </div>


                <table class="table table-striped tabResult">
                    <thead class="thead-light">
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">E-ISSN</th>
                        <th scope="col">P-ISSN</th>
                        <th scope="col">Open Access </th>
                        <th scope="col">Publisher</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for t in data_t_scopus %}
                        {% set compteur=compteur+1 %}
                        {% if (t.eISSN) =="" %}
                            {% set issn=t.printISSN %}
                        {% elseif(t.eISSN) !="" %}
                            {% set issn=t.eISSN %}
                        {% endif %}

                        <tr>
                            <td><a href={{issn}}>{{ t.title }}</a> </td>
                            <td>{{ t.eISSN }}</td>
                            <td>{{ t.printISSN }}</td>
                            <td>{{ t.openAccess }}</td>
                            <td>{{ t.publisher }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                {% endif %}
            </div>
            <div class="col-lg-2">
                <!-- ajouter pour la publicité -->
                {%  if data_t_scopus | length >1 %}
                    <div class="row" ></div>




                {% endif %}

                <!-- fin publicité -->
            </div>
        </div>
        {%  if data_reuter | length ==1 or data_t_scopus | length==1 %}
            <div class="row" >
                <div class="col-lg-12">
                    <h3 align="center">The following title(s) matched your request</h3>
                </div>
            </div>
        {% endif %}
        <div class="row">
            <div class="col-lg-1 col-sm-1"></div>
            <div class="col-lg-5 col-sm-5">

                {%  if data_reuter | length ==1 %}
                    {% set test=0 %}

                    {% set url="http://mjl.clarivate.com/cgi-bin/jrnlst/jlresults.cgi?PC=MASTER&ISSN=*" %}
                    {% if data_reuter.iSSN !=null %}
                        {% set url=url~data_reuter.iSSN %}
                    {% else  %}
                        {% set url=url~data_reuter.eISSN %}
                    {% endif %}

                    <div class="alert bg-light" style="height: 95%;width: 95%">


                        <h3><img src="{{ asset('assets/images/thomson1.png') }}" style="width: 3rem; height: 3rem;"> Thomson Reuters Database</h3>
                        <div class="container">
                            <div class="row">
                                <div class="col-sm-12 col-lg-12">Title : <a href={{ url }} target="_blank">{{ data_reuter.title }} </a></div>
                            </div>
                            <div class="container">
                                <div class="row">
                                    <div class="col-sm-6 col-lg-6">Impact Factor : {{ data_reuter.journalImpactFactor }}</div>
                                    <div class="col-sm-6 col-lg-6">Rank : {{ data_reuter.rank }}</div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6 col-lg-6">Total Cites : {{ data_reuter.totalCites }} </div>
                                    <div class="col-sm-6 col-lg-6">Category name : {{ data_reuter.categoryname }} </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-6 col-lg-6">ISSN : {{ data_reuter.iSSN }}</div>
                                    <div class="col-sm-6 col-lg-6">E-ISSN : {{ data_reuter.eISSN }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% elseif data_t_scopus | length >1 %}
                    {% set test=0 %}
                {% else  %}
                    {% set test=1 %}
                {% endif %}
                {% if test ==1 and data_reuter is not null %}
                    <div class="alert bg-light" style="height: 95%;width: 95%">


                        <h3><img src="{{ asset('assets/images/thomson1.png') }}" style="width: 3rem; height: 3rem;"> Thomson Reuters Database</h3>

                        <h1>Not Found</h1>
                    </div>
                {% endif %}
            </div>
            <div class="col-lg-5 col-sm-5">
                {%  if data_t_scopus | length ==1 %}
                {% set tests=0 %}
                <div class="alert bg-light" style="height: 95%;width: 95%">


                    <h3><img src="{{ asset('assets/images/scopus3.png') }}" style="width: 3rem; height: 3rem;"> Scopus Database</h3>
                    <div class="container">
                        <div class="row">
                            <div class="col-sm-12 col-lg-12">Title : <a href={{ data_t_scopus.scopusSourceID }} target="_blank"> {{ data_t_scopus.title }}</a> </div>
                        </div>
                        <div class="container">
                            <div class="row">
                                <div class="col-sm-6 col-lg-6">SJR : {{ data_t_scopus.sJR }}</div>
                                <div class="col-sm-6 col-lg-6">Rank : {{ data_t_scopus.rANK }} </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6 col-lg-6">Publisher : {{ data_t_scopus.publisher }} </div>
                                <div class="col-sm-6 col-lg-6">Open Access : {{ data_t_scopus.openAccess }} </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6 col-lg-6">Quartile : {{ data_t_scopus.quartile }}</div>
                                <div class="col-sm-6 col-lg-6">Citation Count : {{ data_t_scopus.citationCount }} </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6 col-lg-6">ISSN : {{ data_t_scopus.printISSN }}</div>
                                <div class="col-sm-6 col-lg-6">E-ISSN : {{ data_t_scopus.eISSN }}</div>
                            </div>
                        </div>
                    </div>
                    {% elseif data_t_scopus | length >1 %}
                        {% set tests=0 %}
                    {% else  %}
                        {% set tests=1 %}
                    {% endif %}
                    {% if tests==1 and  data_t_scopus is not null %}
                        <div class="alert bg-light" style="height: 95%;width: 95%">
                            <h3><img src="{{ asset('assets/images/scopus3.png') }}" style="width: 3rem; height: 3rem;"> Scopus Database</h3>
                            <h1>Not Found </h1>

                        </div>
                    {% endif %}



                </div>

            </div>
        </div>

        <div class="row">
            <div class="col-lg-12 text-center">
                {% if eISSN is defined  %}
                    {% set url = absolute_url(path('data_t_scopus_results', {'eISSN': eISSN})) %}
                    {%  if data_reuter | length ==1 %}
                        {% set text_to_share = data_reuter.title %}
                    {%  elseif data_t_scopus | length ==1 %}
                        {% set text_to_share = data_t_scopus.title %}
                    {% else %}
                        {% set text_to_share = 'Journal : ' %}
                    {% endif %}
                    <div class="fb-share-button center"
                         data-href="{{ url }}"
                         data-layout="button_count">
                    </div>
                    <a class="btn"
                       href="https://twitter.com/intent/tweet?
                       &size=large
                       &text={{ text_to_share }}
                       &url={{ url }}">
                        <i></i>
                        <span class="label" id="l">Tweet</span>
                    </a>
                    <script src="https://platform.linkedin.com/in.js" type="text/javascript">lang: en_US</script>
                    <script type="IN/Share" data-url="{{ url }}"></script>
                {% endif %}
            </div>
        </div>

        <div class="row">
            {%  if data_reuter | length ==1 or data_t_scopus | length==1 %}
                <div class="col-sm-2">
                    <!-- ad sense publicite 2-->

                    <!-- carre_un_resultat_gauche -->
                    <ins class="adsbygoogle"
                         style="display:inline-block;width:200px;height:200px"
                         data-ad-client="ca-pub-9897811061542650"
                         data-ad-slot="6788803898"></ins>
                    <script>
                        (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                    <!-- fin ad sense publicite 2-->

                </div>
                <div class="col-sm-8">
                    <!-- Publicité  -->
                    <div class="row" name="pub2" id="pub2">

                        <div class="col-sm-12" >
                            <!-- <h1 align="center">Bonjour ici mettre votre publicité 4 à la place de 2 </h1>-->
                            <!-- /21831250958/guidejournal_home_Pub4 -->
                            <div id='div-gpt-ad-1563190020499-0'>
                                <script>
                                    googletag.cmd.push(function() { googletag.display('div-gpt-ad-1563190020499-0'); });
                                </script>
                            </div>
                        </div>

                    </div>
                    <!-- Publicité  -->
                </div>
                <div class="col-sm-2">

                    <!-- ad sense publicite 3-->

                    <!-- carre_un_resultat_droit -->
                    <ins class="adsbygoogle"
                         style="display:inline-block;width:200px;height:200px"
                         data-ad-client="ca-pub-9897811061542650"
                         data-ad-slot="5966676816"></ins>
                    <script>
                        (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                    <!-- fin ad sense publicite 3-->

                </div>
            {% endif %}
        </div>
    </div>


{% endblock %}