{% extends '@SuluCommunity/profile-form.html.twig' %}

{% block title %}GuideJournal: Publications{% endblock %}

{% block profile_content %}

{#            <h2 style="color: #555">Publication index</h2>#}

            <table class="table">
                <thead>
                    <tr class="table-active">
                        <th colspan="8">Title</th>
{#                        <th>Journal</th>#}
{#                        <th>Url</th>#}
{#                        <th>Volume</th>#}
{#                        <th>Issue</th>#}
{#                        <th>Authors</th>#}
{#                        <th>Year</th>#}
{#                        <th>Volume</th>#}
                        <th>Year</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for publication in publications %}
                    <tr style="border-bottom: 1px #c5c5c5 solid">
                        <td colspan="8" class="w-70 border-0">
                            <p class="font-weight-bold text-primary"><a href="{{ publication.url }}" target="_blank"> {{ publication.title }} </a></p>
                            <p class="font-weight-light text-muted mt-n3">
                                <small>Authors : {{ publication.authors }}</small><br>

{#                            {% if publication.volume%}  <p class="font-weight-light text-muted mt-n3"><small>Volume : {{ publication.volume }}</small></p>{% endif %}#}
                            <small>
                                {{ publication.name }},

                                {% if publication.volume  %}({{ publication.volume }}),{% endif %}
                                    Pages :{% if publication.pages  %}{{ publication.pages }}{% endif %}
                            </small></p>
                        </td>
{#                        <td>{{ publication.journal }}</td>#}
{#                        <td>{{ publication.url }}</td>#}
{#                        <td>{{ publication.volume }}</td>#}
{#                        <td>{{ publication.issue }}</td>#}
{#                        <td>{{ publication.authors }}</td>#}
{#                        <td>{{ publication.volume }}</td>#}
                        <td class="border-0">{{ publication.year }}</td>
                        <td class="border-0">
{#                            <a class="btn btn-primary" href="{{ path('publication_show', {'id': publication.id}) }}">show</a><br><br>#}
{#                            <a href="{{ path('all_publication_edit', {'id': publication.id}) }}">edit</a>#}
                            <a class="btn btn-warning" data-toggle="modal" data-publication="{{ publication.id }}" data-target="#modal_edit" style="color: white;">Edit</a><br><br>
                            <button class="deletePublication btn btn-danger" data-publication="{{ publication.id }}" >
                                <a class="" data-toggle="modal" data-target="#modal_delete" style="color: white;">Delete</a>
                            </button>
                        </td>
                    </tr>

                    <div class="modal fade" id="modal_edit" role="dialog">
                        <div class="modal-dialog" role="document">
                            {#                background-color: #26afe8#}
                            <!-- Modal content-->
                            <div class="modal-content" style="margin-top: 20px;width: 600px;background-color: white;border-radius: 10px;padding: 20px;">
                                <div class="modal-header" style="background-color: white;padding: 15px;">
                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                </div>
                                <h3 style="color: #1d2b3c;padding-top: 25px;padding-bottom: 20px">Edit  Publication</h3>

                                {{ form_start(form) }}
                                {#                <button class="btn btn-info btn mb-3">{{ button_label|default('Save') }}</button>#}
                                {{ form_end(form) }}


                            </div>

                        </div>
                    </div>
                {% else %}
                    <tr>
                        <td colspan="9">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <a class="btn btn-primary offset-5 mt-3" data-toggle="modal"  data-target="#modal_create" style="color: white;padding: 10px 20px">Add Publication</a>

    <div class="modal fade" id="modal_create" role="dialog">
        <div class="modal-dialog" role="document">
            {#                background-color: #26afe8#}
            <!-- Modal content-->
            <div class="modal-content" style="margin-top: 20px;width: 600px;background-color: white;border-radius: 10px;padding: 20px;">
                <div class="modal-header" style="background-color: white;padding: 20px;">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <h3 style="color: #1d2b3c;padding-top: 20px;padding-bottom: 20px">Add  Publication</h3>

                {{ form_start(form2) }}
{#                <button class="btn btn-info btn mb-3">{{ button_label|default('Save') }}</button>#}
                {{ form_end(form2) }}


            </div>

        </div>
    </div>
{#    href="{{ path('publication_new') }}"#}



{% endblock %}


