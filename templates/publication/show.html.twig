{% extends 'member.html.twig' %}

{% block title %}GuideJournal: Publications{% endblock %}

{% block member_content %}

<div class="container">
    <div class="row">
        <div class="col-12">
            <h1>Publication</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ publication.id }}</td>
                    </tr>
                    <tr>
                        <th>Title</th>
                        <td>{{ publication.title }}</td>
                    </tr>
                    <tr>
                        <th>Journal</th>
                        <td>{{ publication.journal }}</td>
                    </tr>
                    <tr>
                        <th>Url</th>
                        <td>{{ publication.url }}</td>
                    </tr>
                    <tr>
                        <th>Volume</th>
                        <td>{{ publication.volume }}</td>
                    </tr>
                    <tr>
                        <th>Issue</th>
                        <td>{{ publication.issue }}</td>
                    </tr>
                    <tr>
                        <th>Authors</th>
                        <td>{{ publication.authors }}</td>
                    </tr>
                    <tr>
                        <th>Year</th>
                        <td>{{ publication.year }}</td>
                    </tr>
                </tbody>
            </table>

            <a href="{{ path('publication_index') }}">back to list</a>

            <a href="{{ path('publication_edit', {'id': publication.id}) }}">edit</a>

            {{ include('publication/_delete_form.html.twig') }}
        </div>
    </div>
</div>

{% endblock %}
