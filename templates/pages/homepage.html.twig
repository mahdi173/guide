                                               <p>
                                                   {{ a.excerptDescription|slice(0,60)|raw  }}...   <br><a href="{{ a.path }}" style="float: right;font-weight: 400" class="text-warning">Read More →</a>
                                               </p>
                                           {% endif %}
                                       </div>
                                   </div>
                               {% endfor %}
                           </div>
                           </div>
