{% extends 'base.html.twig' %}

{% block body %}
    {% if data_t_scopus is not defined %}{% set data_t_scopus = null %} {% endif %}
    {% if data_reuter is not defined %}{% set data_reuter = null %} {% endif %}

    <!-- Load Facebook SDK for JavaScript -->
    <div id="fb-root"></div>
    <script>
        (function(d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v3.0";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
    </script>

    {% set test=-1 %}
    {% set compteur=0 %}
    {% set compteur1=0 %}
    {% set tests=-1 %}

    {% set issn="" %}
    {#        image index#}
    <div class="container-fluid imageindex">
        <div class="row ">
            <div class="offset-3 col-md-6 intro-text">
                <h2>Empowering Knowledge we help you manage work more efficiently so you can spend more time making</h2>

            </div>

        </div>
    </div>
    <div class="container">



        <div class="row col-sm-12" align="center">

            <!-- home_page -->
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-9897811061542650"
                 data-ad-slot="9578484962"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>
                (adsbygoogle = window.adsbygoogle || []).push({});
            </script>
        </div>
        <!-- Fin pub 0001-->
        <div class="row col-sm-12">
            <div class="col-sm-12 col-md-12">
                <h4 class=" services">Free Service for you</h4>
            </div>

            <div class="col-sm-12 col-md-4 services-list " style="padding-left: 43px">
                <div class="row ">
                <div class="col-sm-12 col-md-2 text-primary">
                    <i class="fa fa-file icon-size" aria-hidden="true"></i>
                </div>
                <div class="col-sm-12 col-md-10">
                    <p class="title-service">
                        <a href="{{ path('journalSearch') }}">Journal search</a>

                    </p>
                    <p><span style="color: #e07b39;padding-right: 5px">ScienceDirect</span> <span style="color: #555" >Empowering smarter research at every step</span></p>
                </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-4 services-list text-primary">
                <div class="row ">
                    <div class="col-sm-12 col-md-2 ">
                      <i class="fa fa-search icon-size" aria-hidden="true"></i>
                    </div>
                    <div class="col-sm-12 col-md-10">
                        <p class="title-service">
                            <a  href="{{ path('get_authors') }}" >Author search</a>
                        </p>

                        <p>
                            <span style="color: #555" >Publishing with</span>
                            <span style="color: #e07b39;padding-right: 5px">Elsevier</span>
                            <span style="color: #555" >Step by step guide</span>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-sm-12 col-md-4 services-list ">
                <div class="row ">
                    <div class="col-sm-12 col-md-2 text-primary">
                        <i class="fa fa-bar-chart icon-size" aria-hidden="true"></i>
                    </div>
                    <div class="col-sm-12 col-md-10">
                        <p class="title-service">
                            <a  href="{{ path('graphic_data') }}" class=" title-service">Graph Maker</a></p>
                        <p>
                            <span style="color: #555" >Quantify the reach and impact of your published research</span>
                        </p>
                    </div>
                </div>
            </div>

        </div>

        <div class="card">
            <div class="card-body">
        <div class="row">
            <div class="col-sm-12"> </div>
            <div class="col-md-2 col-sm-1"></div>
            <div class="col-md-8 mt-5">
                {% include '_includes/search_form.html.twig' %}

            </div>
            <div class="col-md-2 col-sm-1"></div>
        </div>
            </div>
        </div>



        <div class="row col-sm-12" align="center" style="height: 60px">
            <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
            <!-- pub_adsence_horizontal_pageH -->
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-9897811061542650"
                 data-ad-slot="7418984239"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>
                (adsbygoogle = window.adsbygoogle || []).push({});
            </script>
        </div>

        <div class="row">
            <h4 class="mb-n2 mt-5 text-primary" ><b>Recent articles</b></h4>
            <hr class="col-md-12 bg-primary" style="height:2px">
        </div>

        <section class="p-0 main-slider">
            <div class="slide-1 home-slider">
                <div class="row">
            {% set recentarticles= sulu_article_load_recent(6) %}
            {% for a in recentarticles %}
                <div class="col-md-3">

                    <div class="card mb-4 box-shadow">

                        {% if a.content.content.image %}
                            {% set media = sulu_resolve_media(a.content.content.image, app.request.locale) %}
{#                            {{ dump(media.thumbnails['sulu-400x400']) }}#}
                            <a href="{{ a.routePath }}"><img class="card-img-top" data-src="{{ media.thumbnails['sulu-400x400'] }}" src="{{ media.thumbnails['sulu-400x400'] }}" data-holder-rendered="true"></a>
                            {% else %}
                                <a href="{{ a.routePath }}"><img class="card-img-top" data-src="{{ asset('assets/images/Guidejournal.png') }}" src="{{ asset('assets/images/Guidejournal.png') }}" data-holder-rendered="true"></a>

                        {% endif %}
{#                        <div class="card-body">#}
                        <div class="">
                            <h5 class="card-title"><a href="{{ a.routePath }}">{{ a.content.content.title }}</a></h5>
                            {% if a.content.content.teaser %}<small>{{ a.content.content.teaser|slice(0,60)|raw  }}...</small>{% endif %}
                            <a href="{{ a.routePath }}" style="float: right">Read More →</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="alert text-info"></p>
            {% endfor %}
        </div>
        </div>
        </section>

</div>

{% endblock %}

