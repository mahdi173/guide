{% extends 'base.html.twig' %}{% block body %}
    {% if data_t_scopus is not defined %}{% set data_t_scopus = null %} {% endif %}
    {% if data_reuter is not defined %}{% set data_reuter = null %} {% endif %}    <!-- Load Facebook SDK for JavaScript -->
    <div id="fb-root"></div>
    <script>
        (function(d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s); js.id = id;
            js.src = "https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v3.0";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
    </script>
    <script>
        $('#carouselExample').on('slide.bs.carousel', function (e) {        var $e = $(e.relatedTarget);
            var idx = $e.index();
            var itemsPerSlide = 5;
            var totalItems = $('.carousel-item').length;        if (idx >= totalItems-(itemsPerSlide-1)) {
                var it = itemsPerSlide - (totalItems - idx);
                for (var i=0; i<it; i++) {
                    // append slides to end
                    if (e.direction=="left") {
                        $('.carousel-item').eq(i).appendTo('.carousel-inner');
                    }
                    else {
                        $('.carousel-item').eq(0).appendTo('.carousel-inner');
                    }
                }
            }
        });</script>
    {% set compteurRSWEB=0 %}
    <div class="container">        <div class="row col-sm-12" align="center" style="height: 150px">
            <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
            <!-- Home_page_horizontal1 -->
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-9897811061542650"
                 data-ad-slot="3798275752"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>
                (adsbygoogle = window.adsbygoogle || []).push({});
            </script>
        </div>
        <!-- Fin pub 0001-->
        <div class="row">
            <div class="col-sm-12"> </div>
            <div class="col-md-2 col-sm-1"></div>
            <div class="col-md-8 mt-5">
                {% include '_includes/search_form.html.twig' %}            </div>
            <div class="col-md-2 col-sm-1"></div>
        </div>        <div class="row col-sm-12" align="center" style="height: 150px">
            <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
            <!-- pub_adsence_horizontal_pageH -->
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-9897811061542650"
                 data-ad-slot="7418984239"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>
                (adsbygoogle = window.adsbygoogle || []).push({});
            </script>
        </div>        <div class="row">
            <h4 class="mb-n2 mt-5 text-primary" ><b>Recent articles</b></h4>
            <hr class="col-md-12 bg-primary" style="height:2px">
        </div>
        <div class="row">
            {% set recentarticles= sulu_article_load_recent(6) %}
            {% for a in recentarticles %}
                <div class="col-md-3">
                    <div class="card mb-4 box-shadow">
                        {% if a.content.content.image %}
                            {% set media = sulu_resolve_media(a.content.content.image, app.request.locale) %}
                            {#                            {{ dump(media.thumbnails['sulu-100x100']) }}#}
                            <a href="{{ a.routePath }}"><img class="card-img-top" data-src="{{ media.thumbnails['sulu-100x100'] }}" src="{{ media.thumbnails['sulu-100x100'] }}" data-holder-rendered="true"></a>
                        {% else %}
                            <a href="{{ a.routePath }}"><img class="card-img-top" data-src="{{ asset('assets/images/Guidejournal.png') }}" src="{{ asset('assets/images/Guidejournal.png') }}" data-holder-rendered="true"></a>                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title"><a href="{{ a.routePath }}">{{ a.content.content.title }}</a></h5>
                            {% if a.content.content.teaser %}<small>{{ a.content.content.teaser|slice(0,60)|raw  }}...</small>{% endif %}
                            <a href="{{ a.routePath }}" style="float: right">Read More →</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="alert text-info"></p>
            {% endfor %}
        </div>        <div class="row">
            <div class="col-sm-12">                    <div id="carouselExample" class="carousel" data-ride="carousel" style="height: 100%">
                    <ol class="carousel-indicators">
                        <li data-target="#carouselExample" data-slide-to="0" class="active">1</li>
                        <li data-target="#carouselExample" data-slide-to="1">2</li>
                        <li data-target="#carouselExample" data-slide-to="2">3</li>
                        <li data-target="#carouselExample" data-slide-to="3">4</li>
                        <li data-target="#carouselExample" data-slide-to="4">5</li>
                        <li data-target="#carouselExample" data-slide-to="5">6</li>
                    </ol>
                    <div class="carousel-inner">                            {% for a in recentarticles %}                                {% set compteurRSWEB=compteurRSWEB+1 %}
                        {% if compteurRSWEB==1 %}
                        <div class="carousel-item active">
                            <div class="col-md-3">
                                <div class="card mb-4 box-shadow">
                                    {% if a.content.content.image %}
                                        {% set media = sulu_resolve_media(a.content.content.image, app.request.locale) %}
                                        {#                            {{ dump(media.thumbnails['sulu-100x100']) }}#}
                                        <a href="{{ a.routePath }}"><img class="card-img-top" data-src="{{ media.thumbnails['sulu-100x100'] }}" src="{{ media.thumbnails['sulu-100x100'] }}" data-holder-rendered="true"></a>
                                    {% else %}
                                        <a href="{{ a.routePath }}"><img class="card-img-top" data-src="{{ asset('assets/images/Guidejournal.png') }}" src="{{ asset('assets/images/Guidejournal.png') }}" data-holder-rendered="true"></a>                                            {% endif %}
                                    <div class="card-body">
                                        <h5 class="card-title"><a href="{{ a.routePath }}">{{ a.content.content.title }}</a></h5>
                                        {% if a.content.content.teaser %}<small>{{ a.content.content.teaser|slice(0,60)|raw  }}...</small>{% endif %}
                                        <a href="{{ a.routePath }}" style="float: right">Read More →</a>
                                    </div>
                                </div>
                            </div>                                {% else %}                                    <div class="carousel-item">                                    <div class="col-md-3">
                                    <div class="card mb-4 box-shadow">
                                        {% if a.content.content.image %}
                                            {% set media = sulu_resolve_media(a.content.content.image, app.request.locale) %}
                                            {#                            {{ dump(media.thumbnails['sulu-100x100']) }}#}
                                            <a href="{{ a.routePath }}"><img class="card-img-top" data-src="{{ media.thumbnails['sulu-100x100'] }}" src="{{ media.thumbnails['sulu-100x100'] }}" data-holder-rendered="true"></a>
                                        {% else %}
                                            <a href="{{ a.routePath }}"><img class="card-img-top" data-src="{{ asset('assets/images/Guidejournal.png') }}" src="{{ asset('assets/images/Guidejournal.png') }}" data-holder-rendered="true"></a>                                            {% endif %}
                                        <div class="card-body">
                                            <h5 class="card-title"><a href="{{ a.routePath }}">{{ a.content.content.title }}</a></h5>
                                            {% if a.content.content.teaser %}<small>{{ a.content.content.teaser|slice(0,60)|raw  }}...</small>{% endif %}
                                            <a href="{{ a.routePath }}" style="float: right">Read More →</a>
                                        </div>
                                    </div>
                                </div>                                {% endif %}
                                <!-- fin mutiple results-->
                                {% endfor %}
                            </div>                        <a class="carousel-control-prev" href="#carouselExample" role="button" data-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="sr-only">Previous</span>
                            </a>
                            <a class="carousel-control-next text-primary" href="#carouselExample" role="button" data-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="sr-only">Next</span>
                            </a>
                        </div>            </div>
                </div>            </div>
        </div>
    </div>
{% endblock %}