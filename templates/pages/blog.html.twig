{% extends 'base.html.twig' %}

{% block content %}


  {#start bootstrap blog#}

  <div class="row">

    <!-- Blog Entries Column -->
    <div class="col-md-8">

      <h1 class="my-4">Guidejournal
        <small>Blog</small>
      </h1>

      <!-- Blog Post -->

      {% for c in content.articles %}
        <div class="card mb-4">
          {% if c.content.content.image %}
            <img class="card-img-top" src="{{ c.content.content.image.url }}" alt="Card image cap">
            {% else %}
            <img class="card-img-top" src="{{ asset('assets/images/Guidejournal.png') }}" alt="Card image cap">
          {% endif %}
          <div class="card-body">
            <h2 class="card-title"><a href="{{ c.routePath }}">{{ c.content.content.title }}</a></h2>
            <div property="article">
              {{ c.content.content.teaser| raw }}
            </div>

            <p class="card-text">{{ c.article|default()|raw }}</p>
            <a href="{{ c.routePath }}" class="btn btn-primary">Read More →</a>
          </div>
          <div class="card-footer text-muted">
            Posted on {{ c.content.published|date('D M Y') }}
{#            <a href="#">{{ c.content.creatorFullName }}#}
            </a>
          </div>
        </div>

      {% endfor %}


    </div>

    <!-- Sidebar Widgets Column -->
    <div class="col-md-4">

      <!-- Search Widget -->
      <div class="card my-4">
        <h5 class="card-header">Search</h5>
        <div class="card-body">
          <form action="{{ path('sulu_search.website_search') }}" method="get">
            <div class="input-group">
              <input name="q" type="text" class="form-control" placeholder="Search for..." />
              <span class="input-group-btn"><button class="btn btn-secondary" type="submit">Go !</button></span>

            </div>
          </form>
        </div>
      </div>

      <!-- Categories Widget -->
      <div class="card my-4">
        <h5 class="card-header">Categories</h5>
        <div class="card-body">
          <div class="row">
            {% for categorie in content.articles %}
              {% for c in categorie.content.content.categories %}
                  <div class="col-lg-6">
                    <ul class="list-unstyled mb-0">


                      <li>
                         <a href="#">

                          {% if c.name %}  {{ c.name }} {% endif %}

                        </a>
                      </li>

                    </ul>
                  </div>
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>

      <!-- Side Widget -->
{#      <div class="card my-4">#}
{#        <h5 class="card-header">Side Widget</h5>#}
{#        <div class="card-body">#}
{#          You can put anything you want inside of these side widgets. They are easy to use, and feature the new Bootstrap 4 card containers!#}
{#        </div>#}
{#      </div>#}

    </div>

  </div>

  {#end bootstrap blog#}

{% endblock %}

