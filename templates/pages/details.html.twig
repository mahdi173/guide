{% extends 'base.html.twig' %}


{% block content %}
    <h2 class="text-primary text-center mt-5">Submit your article via e-mail</h2>
    <div class="row mt-lg-5">
        <div class="col-md-3"></div>
        <div class="col-md-6 border border-primary rounded">
            <div class="p-2">
                <p class="lead text-primary">Articles should be submitted via email to :</p>

                <p class="text-dark">- contact@guidejournal.net</p>
                <p class="text-dark mt-n3">- guidejournal@outlook.com</p>
                <p class="text-dark mt-n3">- contactguidejournal@gmail.com</p>

                <p class="lead text-primary">Details of what files you need to provide : fill in the completely with the data required (e.g.,email adresses, paper title, descipline, etc.). You will also be asked to supply the names and contact details of correspending authors. </p>
                <p class="lead text-primary">Your submession will be acknowleged as soon as possible - please contact us if you have not reseived an acknowlegement within two working days.</p>

            </div>

        </div>
        <div class="col-md-3"></div>
    </div>

{% endblock %}