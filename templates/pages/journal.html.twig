{#{% extends '@SuluCommunity/profile-form.html.twig' %}#}
{% extends 'base.html.twig' %}

{% block title %}GuideJournal: Add journal{% endblock %}

  {% block content %}
      <h1 class="my-4">
          <h2 class="text-primary text-center mt-5 mb-5">Add informtations about your journal</h2>
      </h1>
      <div class="row mt-5">
          <div class="col-md-2"></div>
          <div class="col-md-8">
          {% if content.form %}
              {% if app.request.get('send') != 'true' %}
                  {{ form_start(content.form) }}

                     {% form_theme content.form 'Form/addJournal.html.twig' %}

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">Title</label>
                              {{ form_widget(content.form.title|raw, { 'attr': {'class': 'form-control'} }) }}
                              <small id="emailHelp" class="form-text text-danger">*</small>
                          </div>
                          {{ form_errors(content.form.title) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">Category and descipline ex : Engineering, Computer science</label>
                              {{ form_widget(content.form.text|raw, { 'attr': {'class': 'form-control'} }) }}
                              <small id="emailHelp" class="form-text text-danger">*</small>
                          </div>
                          {{ form_errors(content.form.text) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">Publisher</label>
                              {{ form_widget(content.form.text1|raw, { 'attr': {'class': 'form-control'} }) }}
                              <small id="emailHelp" class="form-text text-danger">*</small>
                          </div>
                          {{ form_errors(content.form.text1) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">P-ISSN</label>
                              {{ form_widget(content.form.text2, { 'attr': {'class': 'form-control'} }) }}
                              <small id="emailHelp" class="form-text text-danger">*</small>
                          </div>
                          {{ form_errors(content.form.text2) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">E-ISSN</label>
                              {{ form_widget(content.form.text3, { 'attr': {'class': 'form-control'} }) }}
                              <small id="emailHelp" class="form-text text-danger">*</small>
                          </div>
                          {{ form_errors(content.form.text3) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">Editor</label>
                              {{ form_widget(content.form.text4, { 'attr': {'class': 'form-control'} }) }}
                              <small id="emailHelp" class="form-text text-danger">*</small>
                          </div>
                          {{ form_errors(content.form.text4) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">Email</label>
                              {{ form_widget(content.form.email, { 'attr': {'class': 'form-control'} }) }}
                              <small id="emailHelp" class="form-text text-danger">*</small>
                          </div>
                          {{ form_errors(content.form.email) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">Image</label>
                              {{ form_widget(content.form.attachment, { 'attr': {'class': 'form-control'} }) }}
                          </div>
                          {{ form_errors(content.form.attachment) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="text-primary">About</label>
                              {{ form_widget(content.form.textarea, { 'attr': {'class': 'form-control'} }) }}
                          </div>
                          {{ form_errors(content.form.textarea) }}
                      </div>

                      <div class="form-group row">
                          <div class="col-sm-12">
                              <label class="checkbox">
                                  {{ form_widget(content.form.checkbox) }} Terms
                              </label>

                          </div>
                          {{ form_errors(content.form.checkbox) }}
                          <div class="col-md-12">
                              <a href="{{ path('privacy_page') }}" target="_blank">Accept terms and conditions</a>
                          </div>
                      </div>
{#                  {{ form_widget(content.form._token) }}#}

{#                        <input class="btn btn-outline-info ml-3" type="submit" value="send">#}
                        {{ form_row(content.form.submit,{'attr':{'class':'btn btn-outline-info ml-3'}}) }}
{#                         {{ dump(content.form) }}#}
                  {{ form_end(content.form, {'render_rest': false}) }}

              {% else %}
                  {{ view.form.entity.successText|raw }}
    {#              <p>successful</p>#}
              {% endif %}
          {% endif %}
          </div>
          <div class="col-md-2"></div>
      </div>
  {% endblock %}


