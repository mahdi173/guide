{% set type=app.request.get('searchOption',"journal") %}
{% set search=app.request.get('searchValue',"") %}
{% set authorValue=app.request.get('authorValue',"") %}
{% set auteur=app.request.get('auteur',"") %}
{% set route=app.request.get('_route') %}
<div class="slider-home">
    <h1>Research guide provides Services For Science</h1>
    <p>Find the most appropriate journal according to various criteria, or authors with their published articles and corresponding journals</p>
    <form method="get" action="{{ url('data_search_by_several_values') }}">
        <div class="container choices">
            <div class="row">
                <input type="hidden" name="searchOption" id="searchType" value="{% if route in ['get_authors','get_authors_publication'] %}author{% else %}{{ type }}{% endif %}">
                <div  class="col-4 form-control choices-btn " id="search-journal" {% if route in ['get_authors','get_authors_publication'] %} style="display: none"{% endif %}>
                    Journal</div>
                <div  class="col-4 form-control choices-btn" id="search-author" {% if route == 'journalSearch' %} style="display: none"{% endif %}>
                    Author</div>
            </div>
        </div>
        <div class="form-group mb-0">
{#            <input type="text" class="form-control" id="search" name="{% if route in ['get_authors','get_authors_publication'] %}authorValue{% else %}searchValue{% endif %}" placeholder="{% if route in ['get_authors','get_authors_publication'] %}Author name{% else %}Full title, words, ISSN{% endif %}" value="{% if authorValue %}{{ authorValue }}{% elseif auteur %}{{ auteur }}{% else %}{{ search }}{% endif %}">#}
            <input type="text" class="form-control" id="search" name="searchValue" placeholder="{% if route in ['get_authors','get_authors_publication'] %}Author name{% else %}Full title, words, ISSN{% endif %}" value="{% if authorValue %}{{ authorValue }}{% elseif auteur %}{{ auteur }}{% else %}{{ search }}{% endif %}">
            <input type="submit" class="form-control submit" id="submit" value="Browse Home">

        </div>
        <div class="form-group advanced_search">
           <a href="{{ path('advanced_search_scopus_web_ofs') }}" >Advanced search ?</a>
        </div>
    </form>
</div>
