{% extends '@SuluCommunity/base.html.twig' %}

{% block content %}

    {%  set user=app.user %}
    {% set firstname = null %}
    {% set lastname = null %}
    {% set fullname = null  %}
    {% set authors = null  %}
    {% set currentUser = app.user  %}
    {% if user %}
        {% set firstname = user.firstName %}
        {% set lastname = user.lastName %}
        {% set fullname = user.fullName %}



    {% set authors = publicationManager.authorsList(user) %}
    {% if fullname and fullname!="" %}

       {% set followers_count= followers_profile.followers(user.fullName)|length %}

    {% endif %}

    {% set currentUser=app.user %}
  {% endif %}
    {% if app.request.get('firstname') and app.request.get('lastname') %}
        {% set firstname = app.request.get('firstname') %}
        {% set lastname = app.request.get('lastname') %}
        {% set id = app.request.get('id') %}
        {% set user = userRepository.userFromConctact(id,firstname,lastname) %}

        {% if user %}
            {% set user=user.0 %}
            {% set followers_count= followers_profile.followers(user.fullName)|length %}
            {% set authors = publicationManager.authorsList(user) %}
        {% endif %}
    {% endif %}


{#    <h1>{{ 'Profile'|trans }}</h1>#}
{#    {% set user= app.user%}#}
    {% if success is defined and success %}
        <p class="text-center border pt-3 pb-3">
{#            {{ 'save_profile_finished'|trans }}#}
            operation was successfully completed
        </p>
    {% endif %}

{#    {{ form(form) }}#}

{% set  count=0%}

    {% if user and user.follows  %}
        {% set  follows=user.follows.values%}
        {% for follow in follows %}
            {% if follow.following == user.fullName %}
               {% set count=count+1%}
            {% endif %}
        {% endfor %}
    {% endif %}
    <div>
        <div class="container margin-top">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-9">
                    <div class="well well-sm">
                        <div class="row">
                            <div class="col-sm-12 col-md-3">
                                {% set media = null %}
                                {% set src = null %}
                                {% if user and user.contact.avatar is not null %}
                                    {% set media = sulu_resolve_media(user.contact.avatar,'fr') %}
                                {% endif %}

                                {% if media is not null %}
                                    {% set src= media.url %}

                                {% else %}
                                    {% set src=  asset('assets/images/profil_new.jpg') %}

                                {% endif %}
                                <img style="height: 160px;width: 160px;margin-top: 20px;" src={{ src}} alt="H" class="img-rounded img-responsive rounded-circle"/>
                            </div>

                            <div class="col-sm-12 col-md-9 mt-5">
{#                                <h4>{{ app.user.username }} | <a href="{{ path('sulu_community.logout') }}">Logout</a></h4>#}

{#                                <div class="col-sm-12 col-md-1" style="float: left">#}
{#                                    <img style="max-height: 50px;max-width: 50px" src="{{ asset('assets/images/Profil.jpg') }}" alt="H" class="img-rounded img-responsive"/>#}
{#                                </div>#}

                                <div class="col-sm-12 col-md-11" style="margin-top: 20px;margin-left: -20px">
                                    <h2 class="text-primary" style="text-transform: capitalize"> {{firstname }}   {{ lastname }}</h2>
                                 {% if user %}
                                     <h6  style="color: #2f2f2f;font-size: 16px">
                                         <strong>{{   user.allpublications|length }}</strong> publications&nbsp;&nbsp;
                                         <strong>0</strong> posts&nbsp;&nbsp;
                                         {% if followers_count>0  %}
                                           <a href="{{ path('followers_index',{"id":user.id,"firstname":user.firstName,'lastname':user.lastName}) }}" class="followers_index" ><strong>{{ followers_count }}</strong>&nbsp;followers&nbsp;&nbsp;</a>
                                        {% else %}
                                            <strong>{{ followers_count }}</strong>&nbsp;followers&nbsp;&nbsp;
                                         {% endif %}
                                         {% if user.follows|length>0  %}
                                            <a href="{{ path('following_index',{"id":user.id,"firstname":user.firstName,'lastname':user.lastName}) }}" class="following_index"> <strong>{{ user.follows|length }}</strong> following</a>
                                              {% else %}
                                             <strong>{{ user.follows|length }}</strong> following
                                         {% endif %}
                                     </h6>
                                 {% endif %}

                                </div>

{#                                <p style="margin-left: 20px">#}
{#                                    <br/>#}
{#                                    <a href= "{{ path('sulu_community.profile') }}">Edit Profile</a> |#}
{#                                    <a href="{{ path('update-password') }}">Change Password</a>#}
{#                                </p>#}
                            </div>
                        </div>
                    </div>
                </div>
                {% if user %}
                   <div class="col-xs-12 col-sm-12 col-md-3" style="color: #555;padding-top: 45px;">
                    Follow me on social <br>media
                    {% if app.request.get('firstname') and  app.request.get('lastname') and currentUser %}
                        {% if app.request.get('id')==currentUser.id and app.request.get('firstname')==currentUser.firstname and  app.request.get('lastname')==currentUser.lastName %}
                           <a class="btn" data-toggle="modal" data-target="#modal_follow" style="color: white;margin-left: 40px;background-color: #efe3b3">Edit</a>
                        {% endif %}

                    {% endif %}
                    <br>
                        <a {% if user.facebook %} href="{{user.facebook  }}" target="_blank"{%else%} href="#" {%endif%}">
                          <img style="margin-top:10px;height: 40px;width: 40px;" src={{ asset('assets/images/facebook.png')}} alt="H"/>
                        </a>

                        <a{% if user.twitter %}  href="{{user.twitter  }}"  target="_blank"{%else%} href="#"{%endif%}>
                          <img style="margin-top:10px;height: 40px;width: 40px;" src={{ asset('assets/images/twitter.png')}} alt="H"/>
                        </a>


                        <a {% if user.linkedIn %} href="{{user.linkedIn  }}"  target="_blank"{%else%} href="#"{%endif%}">
                           <img style="margin-top:10px;height: 45px;width: 45px;" src={{ asset('assets/images/linkedin.png')}} alt="H"/>
                        </a>

                       {% if app.user %}
                            {% set lastname=app.user.lastname %}
                            {% if lastname is  null %}
                            {% set lastname=app.user.fullName %}
                            {% endif %}
                       {% endif %}
                    <div class="mt-4">

                        {% if currentUser and app.request.get('firstname')==currentUser.firstname and  app.request.get('lastname')==currentUser.lastName %}
{#                        <button class="btn btn-danger">#}
{#                            <a style="color: white" href="{{path('share_your_profile', {id:app.user.id ,firstname:app.user.firstname,lastname:lastname}) }} "> Share profile</a>#}
{#                        </button>#}
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

{#        <hr style="width: 90%;margin-bottom: 0px">#}
        <hr style="width: 88%; margin-top: 20px;margin-bottom: 20px; margin-left: 20px;"/>

        {% if user and currentUser and user==currentUser  %}
              <div class="modal fade" id="modal_follow" role="dialog">
            <div class="modal-dialog" role="document">
{#                background-color: #26afe8#}
                <!-- Modal content-->

                    <div class="modal-content" style="margin-top: 20px;width: 600px;background-color: white;border-radius: 10px">
                    <div class="modal-header" style="width: 600px;background-color: white;border-radius: 10px">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>

                    <form method="post" action="{{ url('save_url_social') }}"  style="width: 600px;padding: 30px">
                        <div class="form-group">
                            <label>Facebook URL</label>
                            <input type="text" class="form-control" id="facebook" name="facebook" aria-describedby="emailHelp" placeholder="https://www.facebook.com/yourFacebook" value="{% if user.facebook %} {{user.facebook  }}{%endif%}">
                        </div>
                        <div class="form-group">
                            <label>Twitter URL</label>
                            <input type="text" class="form-control" id="twitter" name="twitter" placeholder="https://www.twitter.com/yourTwitter" value="{% if user.twitter %} {{user.twitter  }}{%endif%}">
                        </div>

                        <div class="form-group">
                            <label>LinkedIn URL</label>
                            <input type="text" class="form-control" id="linkedin"  name="linkedin" placeholder=" https://www.linkedin.com/yourLinkedin" value="{% if user.linkedin %} {{user.linkedin  }}{%endif%}">
                        </div>

                        <br><button type="submit" class="btn btn-primary" style="color: white">Save</button>
                    </form>
                </div>

            </div>
        </div>
        {% endif %}
    <div class = "container mt-5" >

        <div class = "row">

            {#sidebar#}
            <div class = "d-flex col-md-2"  id = "wrapper">
                <div class = "bg-light border-right" id = "sidebar-wrapper">
{#                    <div class="sidebar-heading list-group-item list-group-item-action bg-light" style="fontWeight: bold">Blog</div>#}
{#                    <div class = "list-group list-group-flush" >#}

{#                        <a href="/admin/category/" activeclass="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action bg-light">#}
{#                        Categories#}
{#                        </a>#}
{#                        <a href="/admin/tag/" activeclass="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action bg-light">#}
{#                        Tags#}
{#                        </a>#}
{#                    </div>#}
{#                    <div class="sidebar-heading list-group-item list-group-item-action bg-light" style="fontWeight: bold">Guide Journal</div>#}
                    <div class = "list-group list-group-flush list-sidebar" >
{#                        <a href = "{{ path('sulu_community.profile')}}" class = "list-group-item list-group-item-action bg-light" > Infos </a>#}
                     {% if user %}
                        <a  href="{{ path('publication_index',{'id':user.id,'firstname':user.contact.firstname,'lastname':user.contact.lastName,'id':user.id}) }}" active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action">
                        Publications
                        </a> <span role="presentation" class="divider"></span>
                        <a href="{{ path('book_index',{'id':user.id,'firstname':user.contact.firstname,'lastname':user.contact.lastName}) }}" active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action">
                        Books
                        </a><span role="presentation" class="divider"></span>
                        <a href="{{ path('chapter_index',{'id':user.id,'firstname':user.contact.firstname,'lastname':user.contact.lastName}) }}" active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action ">
                        Chapters
                        </a><span role="presentation" class="divider"></span>
                        <a href="{{ path('conference_index',{'id':user.id,'firstname':user.contact.firstname,'lastname':user.contact.lastName}) }}" active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action ">
                        Conferences
                        </a><span role="presentation" class="divider"></span>
                        <a href="{{ path('favorite_list',{'id':user.id,'firstname':user.contact.firstname,'lastname':user.contact.lastName}) }}" class="list-group-item list-group-item-action ">Saved Journals</a>
                        {% for item in sulu_navigation_root_tree('member') %}
                            <a href="{{ sulu_content_path(item.url, item.webspaceKey) }}"  active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action" title="{{ item.title }}">{{ item.title }}</a>
                        {% endfor %}
{% endif %}
                    </div>
                </div>
            </div>
            {#end#}

            <div style="margin-left: 0px" class="col-7 " >

                {% block profile_content %}
                <h2 class="text-center">Edit Profile</h2><br/>

                    {{ form_start(form, { 'attr': {'class': 'form'} }) }}
                    <div class="form-group">
                        <label for="registration_username">First name </label>
                        {{ form_widget(form.firstName, { 'attr': {'class': 'form-control '} }) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">Last name </label>
                        {{ form_widget(form.lastName, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">Email</label>
                        {{ form_widget(form.mainEmail, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">Avatar </label>
                        {{ form_widget(form.avatar, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">Address </label>
                        {{ form_widget(form.street, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="form-group ">
                        <label for="registration_username">Country </label>
                        {{ form_widget(form.countryCode, { 'attr': {'class': 'form-control'} }) }}
                    </div>

{#                    <div class="form-group ">#}
{#                        <label for="registration_username">Institution </label>#}
{#                        {{ form_widget(form.institution, { 'attr': {'class': 'form-control'} }) }}#}
{#                      #}
{#                    </div>#}
                    {{ form_widget(form._token) }}
                    <button type="submit" id="registration_submit" name="profile[submit]" class="btn btn-info">Update</button>

                    {{ form_end(form, {'render_rest': false}) }}


                {% endblock %}

                {% block profile_share %}


               {% endblock  %}
        </div>
         <div class="col-3" style="border: solid 2px #e6e6e6;">

             {% block left_sidebar %}
                 <table class="table">
                     <tr>
                         <th class="header">Top co-authors
                            <a href="{{ path('co_authors_index',{"id":user.id,"firstname":user.firstName,'lastname':user.lastName}) }}" class="following_index"> <strong style="float: right">View all</strong></a>
                         </th>
                     </tr>
                     <tr>
                         <td>
                             {% if authors|length >0 %}
                                 {% for author in authors|slice(0,3) %}
                                     <a  class="authorLink" href="{{ path('get_authors_publication', {auteur:author}) }}">
                                         <div class="row">
                                             <div  class="col-md-3">
                                                <img src="{{  asset('assets/images/profil_new.jpg') }}" width="50px" height="50px" style="margin-right: 10px;margin-bottom: 10px"> <br>
                                             </div>
                                             <div style="padding-top: 10px" class="col-md-9">{{ author}}</div>
                                         </div>
                                     </a>
                                 {% endfor %}
                             {% else %}
                                 <span style="padding-top: 20px"> No co-authors </span>
                             {% endif %}
                         </td>
                     </tr>
                     <tr>
                         <th class="header">
                             Following ({{user.follows|length  }})
                             <a href="{{ path('following_index',{"id":user.id,"firstname":user.firstName,'lastname':user.lastName}) }}" class="following_index"> <strong style="float: right">View all</strong></a>

                         </th>
                     </tr>
                     <tr>

                         <td>
                             {% if user.follows.values|length >0 %}
                                 {% for follow in user.follows.values|slice(0,3) %}
                                 <a  class="authorLink" href="{{ path('get_authors_publication', {auteur:follow.following}) }}">


                                     {% set stock=publicationManager.isAuthorStocked(follow.following )  %}

                                     {% set media = null %}
                                     {% set src = null %}
                                     {% if stock and stock.contact.avatar is not null %}
                                         {% set media = sulu_resolve_media(stock.contact.avatar,'fr') %}
                                     {% endif %}

                                     {% if media is not null %}
                                         {% set src= media.url %}

                                     {% else %}
                                         {% set src_stocked=  asset('assets/images/profil_new.jpg') %}

                                     {% endif %}
                                     <div class="row">
                                         <div  class="col-md-3">
                                             <img src="{{  src_stocked }}" class="img-rounded img-responsive rounded-circle" width="50px" height="50px" style="margin-right: 10px;margin-bottom: 10px">
                                         </div>
                                         <div style="padding-top: 10px" class="col-md-9"> {{ follow.following }}</div>
                                     </div>
                                 </a>

                                 {% endfor %}
                             {% else %}
                                 <span style="padding-top: 20px">No following </span>
                             {% endif %}
                         </td>
                     </tr>

                     <tr>
                         {% set followers=followers_profile.followers(user.fullName) %}

                         <th class="header">Followers ({{ followers_count }})
                             <a href="{{ path('followers_index',{"id":user.id,"firstname":user.firstName,'lastname':user.lastName}) }}" class="following_index"> <strong style="float: right">View all</strong></a>
                         </th>
                     </tr>
                     <tr>
                         <td>
                             {% if followers|length >0 %}
                                 {% for follower in followers %}
                                     {% if follower.fullName is null or follower.fullName=="" %}
                                         <img src="{{  asset('assets/images/profil_new.jpg') }}" width="50px" height="50px" style="margin-right: 10px;margin-bottom: 10px">
                                         {{ follower.username }}<br>
                                     {% else %}

                                         <a  class="authorLink" href="{{ path('get_authors_publication', {auteur:follower.fullName}) }}">

                                             {% set stocked=publicationManager.isAuthorStocked(follower.fullName )  %}

                                                 {% set media = null %}
                                                 {% set src = null %}
                                                 {% if stocked and stocked.contact.avatar is not null %}
                                                     {% set media = sulu_resolve_media(stocked.contact.avatar,'fr') %}
                                                 {% endif %}

                                                 {% if media is not null %}
                                                     {% set src_stocked= media.url %}

                                                 {% else %}
                                                     {% set src_stocked=  asset('assets/images/profil_new.jpg') %}

                                                 {% endif %}

                                             <div class="row">
                                                 <div  class="col-md-3">
                                                    <img src="{{  src_stocked }}"  class="img-rounded img-responsive rounded-circle" width="50px" height="50px" style="margin-right: 10px;margin-bottom: 10px">
                                                 </div>
                                                 <div style="padding-top: 10px" class="col-md-9"> {{ follower.fullName }}</div>
                                             </div>
                                         </a>
                                     {% endif %}
                                 {% endfor %}
                             {% else %}
                                   <span style="padding-top: 20px"> No followers </span>
                             {% endif %}
                         </td>
                     </tr>
                 </table>
             {% endblock  %}

         </div>
        </div>

    </div>
    </div>
{% endblock %}
