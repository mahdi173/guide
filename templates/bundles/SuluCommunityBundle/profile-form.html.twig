{% extends '@SuluCommunity/base.html.twig' %}

{% block content %}
{#    <h1>{{ 'Profile'|trans }}</h1>#}
    {% set user= app.user%}
    {% if success is defined and success %}
        <p class="text-center border pt-3 pb-3">
{#            {{ 'save_profile_finished'|trans }}#}
            operation was successfully completed
        </p>
    {% endif %}

{#    {{ form(form) }}#}

    <div>
        <div class="container margin-top">
            <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-9">
                    <div class="well well-sm">
                        <div class="row">
                            <div class="col-sm-12 col-md-4">
{#                                {{ dump(app.user.contact.avatar.files) }}#}
                                <img style="max-height: 150px;max-width: 150px" src="{{ asset('assets/images/logo1.png') }}" alt="H" class="img-rounded img-responsive"/>
                            </div>
                            <div class="col-sm-12 col-md-8 mt-5">
                                <h4>{{ app.user.username }} | <a href="{{ path('sulu_community.logout') }}">Logout</a></h4>
                                <p>
                                    <br/>
                                    <a href= "{{ path('sulu_community.profile') }}">Edit Profile</a> |
                                    <a href="{{ path('update-password') }}">Change Password</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-3" style="color: #555">
                    Follow me on social <br>media
                    <a class="btn btn-warning" data-toggle="modal" data-target="#modal_follow" style="color: white;margin-left: 40px">Edit</a><br>
                    <a href="{% if user.facebook %} {{user.facebook  }}{%else%}#{%endif%}" target="_blank">
                       <i class="fa fa-facebook icon-social" style="border: 1px solid black;padding: 13px;margin-top: 10px"></i>
                    </a>
                    <a href="{% if user.twitter %} {{user.twitter  }}{%else%}#{%endif%}" target="_blank">
                       <i class="fa fa-twitter icon-social" style="border: 1px solid black;padding: 13px;"></i>
                    </a>
                    <a href="{% if user.linkedIn %} {{user.linkedIn  }}{%else%}#{%endif%}" target="_blank">
                       <i class="fa fa-linkedin icon-social" style="border: 1px solid black;padding: 13px;"></i>
                    </a>
                </div>

            </div>
        </div>

        <div class="modal fade" id="modal_follow" role="dialog">
            <div class="modal-dialog" role="document">
{#                background-color: #26afe8#}
                <!-- Modal content-->
                <div class="modal-content" style="margin-top: 20px;width: 600px;background-color: white;border-radius: 10px">
                    <div class="modal-header" style="width: 600px;background-color: white;border-radius: 10px">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <form method="post" action="{{ url('save_url_social') }}"  style="width: 600px;padding: 30px">
                        <div class="form-group">
                            <label>Facebook URL</label>
                            <input type="text" class="form-control" id="facebook" name="facebook" aria-describedby="emailHelp" placeholder="Enter Facebook URL">
                        </div>
                        <div class="form-group">
                            <label>Twitter URL</label>
                            <input type="text" class="form-control" id="twitter" name="twitter" placeholder="Enter Twitter URL">
                        </div>

                        <div class="form-group">
                            <label>LinkedIn URL</label>
                            <input type="text" class="form-control" id="linkedin"  name="linkedin" placeholder="Enter LinkedIn URL">
                        </div>

                        <br><button type="submit" class="btn btn-primary" style="color: white">Submit</button>
                    </form>
                </div>

            </div>
        </div>
    <div class = "container mt-5" >

        <div class = "row">

            {#sidebar#}
            <div class = "d-flex col-md-3" id = "wrapper">
                <div class = "bg-light border-right" id = "sidebar-wrapper">
{#                    <div class="sidebar-heading list-group-item list-group-item-action bg-light" style="fontWeight: bold">Blog</div>#}
{#                    <div class = "list-group list-group-flush" >#}

{#                        <a href="/admin/category/" activeclass="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action bg-light">#}
{#                        Categories#}
{#                        </a>#}
{#                        <a href="/admin/tag/" activeclass="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action bg-light">#}
{#                        Tags#}
{#                        </a>#}
{#                    </div>#}
                    <div class="sidebar-heading list-group-item list-group-item-action bg-light" style="fontWeight: bold">Guide Journal</div>
                    <div class = "list-group list-group-flush" >
                        <a href = "{{ path('sulu_community.profile')}}" class = "list-group-item list-group-item-action bg-light" > Infos </a>
                        <a href="{{ path('publication_index') }}" active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action bg-light">
                        Publications
                        </a>
                        <a href="{{ path('book_index') }}" active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action bg-light">
                        Books
                        </a>
                        <a href="{{ path('chapter_index') }}" active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action bg-light">
                        Chapters
                        </a>
                        <a href="{{ path('conference_index') }}" active="list-group-item list-group-item-action bg-light" class="list-group-item list-group-item-action bg-light">
                        Conferences
                        </a>
                        <a href="{{ path('favorite_list') }}" class="list-group-item list-group-item-action bg-light">My Journals List</a>
                        {% for item in sulu_navigation_root_tree('member') %}
                            <a href="{{ sulu_content_path(item.url, item.webspaceKey) }}" class="list-group-item list-group-item-action bg-light" title="{{ item.title }}">{{ item.title }}</a>
                        {% endfor %}

                    </div>
                </div>
            </div>
            {#end#}

            <div class="col-8">

                {% block profile_content %}
                <h2>Edit Profile</h2><br/>

                    {{ form_start(form, { 'attr': {'class': 'form'} }) }}
                    <div class="form-group">
                        <label for="registration_username">First name :</label>
                        {{ form_widget(form.firstName, { 'attr': {'class': 'form-control '} }) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">First name :</label>
                        {{ form_widget(form.lastName, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">First name :</label>
                        {{ form_widget(form.mainEmail, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">Avatar :</label>
                        {{ form_widget(form.avatar, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">Adress :</label>
                        {{ form_widget(form.street, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="form-group ">
                        <label for="registration_username">Country :</label>
                        {{ form_widget(form.countryCode, { 'attr': {'class': 'form-control'} }) }}
                    </div>

                    {{ form_widget(form._token) }}
                    <button type="submit" id="registration_submit" name="profile[submit]" class="btn btn-info">Update</button>

                    {{ form_end(form, {'render_rest': false}) }}


                {% endblock %}
                </div>



        </div>

    </div>
    </div>
{% endblock %}
