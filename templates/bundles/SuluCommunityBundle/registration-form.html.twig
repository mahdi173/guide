{% extends '@SuluCommunity/base.html.twig' %}

{% block security %}
    <h1 class="text-center">{{ 'Registration'|trans }}</h1>

    {% if (app.request.get('send') == 'true')  %}
        <p class="text-center border pt-3 pb-3">
            operation was successfully completed, Please confirm from your email acount !
        </p>
    {% else %}
        {{ form_start(form, { 'attr': {'class': 'form'} }) }}
        <div class="col">{{ form_errors(form) }}</div>
        <div class="form-label-group ">
            <label for="registration_username">First name :</label>
            {{ form_widget(form.firstName, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_lastName">Last name :</label>
            {{ form_widget(form.lastName, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_username">Username :</label>
            {{ form_widget(form.username, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.username) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_email">Email :</label>
            {{ form_widget(form.email, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.email) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_plainPassword">Password:</label>
            {{ form_widget(form.plainPassword.first, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.plainPassword.first) }}
        </div>
        <div class="form-label-group ">
            <label for="registration_plainPassword">Repeat password:</label>
            {{ form_widget(form.plainPassword.second, { 'attr': {'class': 'form-control'} }) }}
            {{ form_errors(form.plainPassword.second) }}
        </div>
        <div class="checkbox mb-3">
            <label class="mr-lg-2 mt-4">
                {{ form_widget(form.terms) }} <a href="{{ path('privacy_page') }}" target="_blank">Accept terms and conditions</a>
            </label>
        </div>
        {{ form_widget(form._token) }}
        <button type="submit" id="registration_submit" name="registration[submit]" class="btn btn-lg btn-info mr-2 mr-lg-2">Register</button>
        {{ form_end(form, {'render_rest': false}) }}

    {% endif %}
{% endblock %}
