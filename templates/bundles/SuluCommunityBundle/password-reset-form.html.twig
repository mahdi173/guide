{% extends '@SuluCommunity/base.html.twig' %}

{% block content %}
    <h1>{{ 'Password_reset'|trans }}</h1>

    {% if app.request.get('send') == 'true' %}
        <p class="text-center border pt-3 pb-3">
{#            {{ 'password_reset_finished'|trans }}#}
            password reset finished
        </p>
    {% else %}
        {% if form %}
{#            {{ form(form) }}#}

            <div class="col-6" style="margin: 50px auto">
                <h4 style="font-weight: bold">Reset password</h4><br/>

                {{ form_start(form) }}
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="registration_username">Enter new password :</label>
                                {{ form_widget(form.plainPassword) }}
                                {{ form_errors(form.plainPassword) }}
                            </div>

                            <div class="pt-4">
                                {{ form_widget(form._token) }}
                                <button type="submit" id="reset_password_submit" name="profile[submit]" class="btn btn-primary">Reset password</button>

                            </div>
                        </div>
                    </div>
                </div>

                {{ form_end(form, {'render_rest': false}) }}

            </div>
        {% else %}
            {{ 'password_reset_token_invalid'|trans }}
        {% endif %}
    {% endif %}
{% endblock %}
