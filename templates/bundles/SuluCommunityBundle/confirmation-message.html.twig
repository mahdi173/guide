{% extends '@SuluCommunity/base.html.twig' %}

{% block content %}
    <div style="height: 30vw;padding-top: 20%">
        <h1 class="text-center">{{ 'Confirmation'|trans }}</h1>
        {% if success %}
            <p class=" border pt-3 pb-3 alert alert-success">
                {#            {{ 'confirmation_finished'|trans }}#}
                Registration was done successfully
            </p>
        {% else %}
            <p class=" border pt-3 pb-3  alert alert-danger">
                {{ 'confirmation_failed'|trans }}
            </p>
        {% endif %}
    </div>

{% endblock %}
