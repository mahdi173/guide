{% block content %}
  <div id="idMPwdFroget" class="modal">
      <form class="modal-content animate">

          <span onclick="document.getElementById('idMPwdFroget').style.display='none'" class="close" title="Close Modal">

            <img class="x-solid"  src="{{ asset('/assets/images/svg/x-solid.svg') }}" alt="" />

          </span>
          <div class="align-self-center mt-5">
            <h2 class="forgetTitle">  Password forget</h2>
            <p class="helpPwdForget">Enter your email in the field bellow in order to getan email to reset your password </p>
          </div>
            <div class="container">
                  <div>
                        <i class="fa fa-envelope" style='position: absolute; margin-top: 62px; margin-left: 47px;'></i>
                        <input type="text" placeholder="E-mail" style="font-family:Montserrat;margin-top: 50px; padding-left: 39px; margin-left: 35px;font-size: 17px; margin-right: 30px; width: 600px; height: 40px; color:#808080;">
                  </div>
                    

                  <button  class='valid'><p>Reset Password</p></button>

                  <p class='inscrit' style="margin-right: 490;"> Vous n'avez pas de compte ?<a href="#" style='all: unset; color: #0071B5;'> Inscrivez-vous</a></p>

                  {#test#}
                 <a onclick="document.getElementById('idMPwdFrogetResponse').style.display='block'">test</a>
            </div>
      </form>
  </div>
  <div id="idMPwdFrogetResponse" class="modal">
      <form class="modal-content animate" action="/action_page.php" method="post">

          <span onclick="document.getElementById('idMPwdFrogetResponse').style.display='none'" class="close" title="Close Modal">

            <img class="x-solid"  src="{{ asset('/assets/images/svg/x-solid.svg') }}" alt="" />

          </span>
            <div class="align-self-center" style="margin-top:250px">
              <h2 class="forgetTitle">  Password forget</h2>
              <p class="helpPwdForget">link containing a validation codehas just been sent to your email </p>
            </div>
            <p class='inscrit'> Vous n'avez pas de compte ?<a href="#" style='all: unset; color: #0071B5;'> Inscrivez-vous</a></p>
            
        </form>
  </div>
{% endblock %}
