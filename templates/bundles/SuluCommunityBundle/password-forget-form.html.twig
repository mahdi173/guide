{% extends '@SuluCommunity/base.html.twig' %}

{% block content %}
    <h1>{{ 'Password_forget'|trans }}</h1>

    {% if app.request.get('send') == 'true' %}
        <p>
            {{ 'password_forget_finished'|trans }}
        </p>
    {% else %}
{#        {{ dump(form(form)) }}#}

        <div class="col-6" style="margin: 50px auto">
            <h4 style="font-weight: bold">Reset Password Request</h4><br/>
            <p>Enter your email in the field bellow in order to get an email to reset your password</p>

                {{ form_start(form) }}
                <div class="container">
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="registration_username">Username or email address :</label>
                                {{ form_widget(form.email_username) }}
                                {{ form_errors(form.email_username) }}
                            </div>

                            <div class="pt-4">
                                {{ form_widget(form._token) }}
                                <button type="submit" id="update_submit" name="profile[submit]" class="btn btn-primary">Reset password</button>

                            </div>
                        </div>
                    </div>
                </div>

                {{ form_end(form, {'render_rest': false}) }}

        </div>
    {% endif %}
{% endblock %}
