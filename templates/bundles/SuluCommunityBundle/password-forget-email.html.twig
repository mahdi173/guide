{% extends '@SuluCommunity/base-email.html.twig' %}

{% block content %}
    {% set url = url('sulu_community.password_reset', { token: user.passwordResetToken }) %}

    <div class="alert alert-primary" role="alert">
        <p>Hello {{ user.firstName }} {{ user.lastName }}</p>
        To reset your password - please visit  <a href="{{ url }}" class="alert-link">
                                                    {{ url }}
                                                </a>
        <p>Regards,</p>
        <p>the Guidejournal Team.</p>
    </div>
{% endblock %}
