{% extends '@SuluCommunity/base.html.twig' %}

{% block content %}
{#    <h1>{{ 'Profile'|trans }}</h1>#}

            <div>

                <div class="col-8"><br/><br/>

                    <h2>Edit Profile</h2><br/>

                    {{ form_start(form, { 'attr': {'class': 'form'} }) }}

                    <div class="form-group">
                        <label for="registration_username">old password :</label>
                        {{ form_widget(form.oldPassword, { 'attr': {'class': 'form-control '} }) }}
                        {{ form_errors(form.oldPassword) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">new password :</label>
                        {{ form_widget(form.plainPassword.first, { 'attr': {'class': 'form-control '} }) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>
                    <div class="form-group">
                        <label for="registration_username">confirm password :</label>
                        {{ form_widget(form.plainPassword.second, { 'attr': {'class': 'form-control '} }) }}
                        {{ form_errors(form.plainPassword.second) }}
                    </div>

                    {{ form_widget(form._token) }}
                    <button type="submit" id="update_submit" name="update_password[submit]" class="btn btn-info">Update</button>

                    {{ form_end(form, {'render_rest': false}) }}

                </div>

            </div>
{% endblock %}
