{% trans_default_domain 'FOSUserBundle' %}

<h4>Reset Password Request</h4>
<p>Enter your email in the field bellow in order to get an email to reset your password</p>
<form action="{{ path('fos_user_resetting_send_email') }}" method="POST" class="fos_user_resetting_request s12">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <input type="text" id="username" name="username" required="required" data-ng-model="name1" class="validate">
                <label for="username">{{ 'resetting.request.username'|trans }}</label>
            </div>
        </div>

        <div class="row">
            <div class="col-4 text-right">
                <input type="submit" value="{{ 'resetting.request.submit'|trans }}" class="waves-effect waves-light log-in-btn">
            </div>
        </div>
        <div style="clear: both"></div>
    </div>
</form>

