{% trans_default_domain 'FOSUserBundle' %}

<h4>Set new password </h4>
<p>Enter your new password</p>
{{ form_start(form, { 'action': path('fos_user_resetting_reset', {'token': token}), 'attr': { 'class': 's12' } }) }}
<div class="container">
    <div class="row">
        <div class="col-10">
            {{ form_widget(form.plainPassword) }}
        </div>
    </div>

    <div class="row">
        <div class="col-4 text-right">
            <input type="submit" value="{{ 'resetting.reset.submit'|trans }}" class="waves-effect waves-light log-in-btn">
        </div>
    </div>
    <div style="clear: both"></div>
</div>
{{ form_end(form) }}
