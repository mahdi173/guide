<div class="col-12" style="margin: 50px auto;">
    <h2>Profile</h2>

    <div class="container">
        <div class="row">
            <div class="col-12">
                <a style="color: #fff" href="{{ path('fos_user_profile_edit') }}" class="waves-effect waves-light btn-large">Edit my profile</a>
                <table class="table table-striped">
                    <tbody>
                    <tr>
                        <td>Name</td>
                        <td>:</td>
                        <td>{{ user.fullName }}</td>
                    </tr>
                    <tr>
                        <td>Eamil</td>
                        <td>:</td>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <td>Country</td>
                        <td>:</td>
                        <td>{{ user.country }}</td>
                    </tr>
                    <tr>
                        <td>Institution</td>
                        <td>:</td>
                        <td>{{ user.institution }}</td>
                    </tr>
                    <tr>
                        <td>Department</td>
                        <td>:</td>
                        <td>{{ user.departement }}</td>
                    </tr>
                    <tr>
                        <td>Speciality</td>
                        <td>:</td>
                        <td>{{ user.speciality }}</td>
                    </tr>
                    <tr>
                        <td>Status</td>
                        <td>:</td>
                        <td> <span class="db-done">Active</span> </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
