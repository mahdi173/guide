{% extends 'base.html.twig' %}

{% block body %}
<script src="dist/js/bootstrap.min.js"></script>
<body>
<div class="container-fluid">
    <div class="row" style="height: 150px; background-color: rgba(225,227,221,0.99)">
        <div class="col-lg-12 col-sm-12"></div>
    </div>
    <div class="container">
        <div class="row" style="height: 20px"></div>
        <div class="row">
            <div class="col-lg-2 col-sm-2"></div>
            <div class="col-lg-8 col-sm-8">
                {{ form_start(form) }}
                {{ form_widget(form) }}
                <form class="form-inline" style="align-self: center">
                    <div class="form-group mx-sm-3 mb-2" >
                        <input  class="form-control" placeholder="Title, ISSN, Words" style="width: 550px"; height="40px">
                    </div>
                    <button type="submit" class="btn btn-primary mb-2">Search</button>
                </form>
                {{ form_end(form) }}
            </div>
            <div class="col-lg-2 col-sm-2"></div>
        </div>
        <div class="row" style="height: 20px"></div>
        <div class="row">
            <div class="col-lg-6 col-sm-6">
                <div class="alert alert-secondary" style="height: 400px;width: 95%">

                    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-6">
                <div class="alert alert-secondary" style="height: 400px;width: 95%">
                    <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="row" style="height: 150px; background-color: rgba(225,227,221,0.99)">
        <div class="col-lg-12 col-sm-12"></div>
    </div>
</div>
{% endblock %}